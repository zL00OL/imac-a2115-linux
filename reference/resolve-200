#!/bin/sh
# DaVinci Resolve launcher for the iMac 5K.
#
# Installed as /usr/local/bin/resolve-200
#
# Why RUSTICL_ENABLE=radeonsi
# ----------------------------
# Rusticl does not advertise OpenCL support for any GPU driver by default; the
# upstream default is deliberately empty while the driver matures. Without this
# variable set, rusticl is present, clinfo may list a platform, and DaVinci
# Resolve still reports no OpenCL-capable GPU. It must be set for the process
# that needs it, which is why it lives here rather than in /etc/environment or
# a global ld.so.conf entry.
# Refs: Arch Wiki DaVinci_Resolve (tested with RUSTICL_ENABLE=radeonsi),
# Mesa MR 21305 / commit 0a072bb3 (rusticl support in Resolve).
#
# Why QT_ENABLE_HIGHDPI_SCALING
# -----------------------------
# Resolve 21.1 bundles Qt 5.15.2 and ships only libqxcb.so, so it runs under
# XWayland. On Qt 5, QT_SCALE_FACTOR is ignored for widget geometry unless
# high-DPI scaling is enabled explicitly - setting only the scale factor
# silently does nothing. Qt 6 needs none of this; it is on by default.

export QT_ENABLE_HIGHDPI_SCALING=1
export QT_AUTO_SCREEN_SCALE_FACTOR=0
export QT_SCALE_FACTOR=2
export QT_FONT_DPI=192

# GPU compute for Resolve. radeonsi is correct for the Radeon Pro 580
# (polaris10) in the 2019 5K iMac.
export RUSTICL_ENABLE=radeonsi

exec /opt/resolve/bin/resolve "$@"