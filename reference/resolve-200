#!/bin/sh
# DaVinci Resolve launcher for the iMac 5K (iMac19,1 / A2115).
# Installed as /usr/local/bin/resolve-200
#
# GPU OpenCL for Resolve -- why this is all process-scoped
# -------------------------------------------------------
# openSUSE ships no OpenCL driver. The freedesktop Flatpak GL runtime on this
# machine contains a complete Mesa rusticl, but it needs two things the system
# does not provide, and both had to be solved WITHOUT touching global linker
# configuration. An earlier attempt added the runtime to /etc/ld.so.conf.d,
# which put Flatpak Mesa on the global search path and stopped KWin from
# starting, i.e. it broke the graphical login. Never do that.
#
# 1. libLLVMSPIRVLib.so.21.1 - the runtime needs LLVM 21, the system has LLVM 23.
#    Solved with LD_LIBRARY_PATH below, which affects only this process.
#
# 2. libclc SPIR-V bitcode. rusticl looks for
#       /usr/lib/x86_64-linux-gnu/GL/default/share/clc/spirv-mesa3d-.spv
#    which is a hardcoded *Debian* path with no environment override (rusticl
#    only honours CLC_DEBUG). The two .spv files are therefore staged there.
#    That path is unused by openSUSE's Mesa, which keeps libclc in
#    /usr/share/clc, so an inert copy here shadows nothing. This is data only -
#    no library is placed on any search path.
#
# RUSTICL_ENABLE=radeonsi is also required: rusticl advertises no GPU driver at
# all by default, so without it a perfectly good rusticl still leaves Resolve
# reporting no OpenCL-capable GPU.
#
# Verified: rusticl exposes "AMD Radeon Graphics (radeonsi, polaris10, ACO)",
# Device Type GPU, 28 compute units, OpenCL 3.1.
#
# Qt 5.15 (which Resolve 21.1 bundles, running under XWayland) ignores
# QT_SCALE_FACTOR for widget geometry unless high-DPI is enabled explicitly.
# Qt 6 needs none of this; it is on by default.

set -e

ICD=/etc/OpenCL/vendors/rusticl.icd
RT_LIB=""
RT_CLC=""

if [ -r "$ICD" ]; then
  DRIVER=$(cat "$ICD" 2>/dev/null | head -1)
  if [ -n "$DRIVER" ] && [ -e "$DRIVER" ]; then
    RT_LIB=$(dirname "$DRIVER")
    RT_CLC=$(cd "$RT_LIB/../share/clc" 2>/dev/null && pwd || true)
  fi
fi

# Tell rusticl to advertise the radeonsi driver. Harmless if rusticl is absent.
RUSTICL_ENABLE=radeonsi
export RUSTICL_ENABLE

# Supply libLLVMSPIRVLib.so.21.1 to this process only - never a global
# ld.so.conf entry, which previously stopped KWin starting.
#
# Point this at /opt/resolve/rusticl-libs, which holds ONLY that one library,
# rather than at the whole Flatpak runtime lib directory. The runtime also
# ships its own libLLVM.so.21.1 and 45 other libraries; putting that directory
# on LD_LIBRARY_PATH would shadow the system copies of all of them for Resolve
# and anything it spawns. The single library is enough - libLLVM.so.21.1 is
# already provided system-wide by libLLVM21.
SPIRV_DIR=/opt/resolve/rusticl-libs
if [ -e "$SPIRV_DIR/libLLVMSPIRVLib.so.21.1" ]; then
  LD_LIBRARY_PATH="$SPIRV_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export LD_LIBRARY_PATH
fi

# 200% scaling on the 5K panel under XWayland / Qt 5.15.
#
# All five are needed. QT_SCALE_FACTOR alone does nothing on Qt 5 widget
# geometry unless QT_ENABLE_HIGHDPI_SCALING is set. QT_SCREEN_SCALE_FACTORS and
# GDK_SCALE cover the parts of the UI that Qt does not scale itself (menus,
# some dialogs). Dropping any of them leaves Resolve partly or wholly at 100%.
QT_ENABLE_HIGHDPI_SCALING=1
QT_AUTO_SCREEN_SCALE_FACTOR=0
QT_SCALE_FACTOR=2
QT_SCREEN_SCALE_FACTORS=2
QT_FONT_DPI=192
GDK_SCALE=2
export QT_ENABLE_HIGHDPI_SCALING QT_AUTO_SCREEN_SCALE_FACTOR QT_SCALE_FACTOR
export QT_SCREEN_SCALE_FACTORS QT_FONT_DPI GDK_SCALE

# Debugging aid: print the environment this launcher would use, and confirm
# whether rusticl reports a GPU, without starting Resolve.
case "${1:-}" in
  --print-env)
    echo "RUSTICL_ENABLE=$RUSTICL_ENABLE"
    echo "LD_LIBRARY_PATH=$LD_LIBRARY_PATH"
    echo "QT_SCALE_FACTOR=$QT_SCALE_FACTOR QT_SCREEN_SCALE_FACTORS=$QT_SCREEN_SCALE_FACTORS QT_FONT_DPI=$QT_FONT_DPI GDK_SCALE=$GDK_SCALE"
    echo "LD dir: ${SPIRV_DIR:-<none>}"
    echo "runtime lib (reference only): ${RT_LIB:-<none>}"
    echo "libclc staged: $([ -f /usr/lib/x86_64-linux-gnu/GL/default/share/clc/spirv-mesa3d-.spv ] && echo yes || echo no)"
    echo "--- clinfo as this launcher sees it ---"
    clinfo -l 2>&1 | sed 's/^/  /'
    exit 0
    ;;
esac

exec /opt/resolve/bin/resolve "$@"