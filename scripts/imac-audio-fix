#!/bin/bash
# imac-audio-fix - RETIRED. Superseded by scripts/imac-audio.
#
# This script was written around a conclusion that has since been disproved. It
# believes jackdanyell's CS8409 fork "targets the iMac18,3" and should be
# removed in favour of davidjo's driver. The opposite is true: jackdanyell's
# tree carries the headset capture fix, and this script would have removed it.
#
# Its final section, verbatim from the version that was here:
#
#     # Only one CS8409 driver may be active. jackdanyell's fork is for the iMac18,3.
#     if dkms status 2>/dev/null | grep -qi 'snd_hda_macbookpro/0.2'; then
#       warn "jackdanyell 0.2 DKMS registration also present - it may win the codec bind"
#       hint "sudo dkms remove snd_hda_macbookpro/0.2 --all"
#     fi
#
# It also forced 4-channel output, which is not what this machine wants.
#
# It has been kept as a stub rather than deleted so that an older guide, a
# muscle-memory habit, or a link to it fails with an explanation instead of
# quietly undoing a working fix. The full version is in git history.

cat >&2 <<'EOF'

  imac-audio-fix: RETIRED - do not run this.

  It would remove the driver that makes headset (EarPods) capture work.
  It is also built for a different approach: davidjo's driver hand-placed
  into updates/ext01, rather than jackdanyell's tree built through DKMS.

  Use instead:

      sudo scripts/imac-audio --check     verify what is loaded now
      sudo scripts/imac-audio --install   build and install the patched driver
      sudo scripts/imac-audio --mic       microphone diagnostics
      scripts/imac-audio --help           full options

  See docs/audio.md for why the old conclusion was wrong.

EOF

exit 1