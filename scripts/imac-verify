#!/bin/bash
#==============================================================================
# imac-verify - one command that says whether this machine is actually working
#
#   sudo scripts/imac-verify
#   sudo scripts/imac-verify --no-sudo      # skip the checks that need root
#
# Changes NOTHING. Read-only throughout.
#
# Paste the output into an issue. It answers, in one screen, the question that
# "my screen looks wrong" cannot.
#
# WHAT THIS SCRIPT WILL NOT DO
# ----------------------------
# It will not report OK for anything that was never measured on the reference
# machine. Display tearing and cold-boot panel initialisation are real questions
# with no verified answer, so they are reported as UNKNOWN rather than guessed
# at. An UNKNOWN line means "nobody has checked", not "probably fine".
#
# See docs/reference-system.md for the full record of what is and is not
# verified, and docs/recovery.md if the display is broken.
#==============================================================================
set -uo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/bin

SUDO_OK=1
USE_SUDO=1
for a in "$@"; do
  case "$a" in
    --no-sudo) USE_SUDO=0 ;;
    -h|--help) sed -n '3,24p' "$0" | sed 's/^# \{0,1\}//; s/^#$//'
               exit 0 ;;
    *) echo "unknown option: $a" >&2; exit 2 ;;
  esac
done

S() { [ "$USE_SUDO" = 1 ] && [ "$SUDO_OK" = 1 ] && sudo -n "$@"; }

PASS=0; FAIL=0; WARN=0; UNK=0
ok()   { printf '  [ ok ] %s\n' "$*"; PASS=$((PASS+1)); }
no()   { printf '  [FAIL] %s\n' "$*"; FAIL=$((FAIL+1)); }
warn() { printf '  [warn] %s\n' "$*"; WARN=$((WARN+1)); }

# Space-separated membership test, used for the srcversion lists. Those hold one
# value per kernel: rebuilding the same patches against a new source tree yields
# a new srcversion, so the test is "is this one of the known values", not equality
# against a single constant.
in_list() { case " $2 " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
unk()  { printf '  [????] %s\n' "$*"; UNK=$((UNK+1)); }
info() { printf '  ->     %s\n' "$*"; }
sec()  { printf '\n%s\n' "$*"; }

# Values verified on the reference machine (docs/reference-system.md)
# Measured srcversions. The patched value differs PER KERNEL - a rebuild of the
# same patches against a new tree produces a new srcversion - so this is a list,
# not a single constant, and membership is the test. Hardcoding the 7.2.2 value
# made this script report a healthy 7.2.8 module as unrecognised.
REF_PATCHED_SRCV="6BE242C1C62DD79046F2E9A 31F26E96354E3264CF28120"
REF_STOCK_SRCV="4FA5DDFCFF3DDAE9F5FE22E 4BFAA1013BED7E3FB557CF0"
REF_STITCH=-1
REF_KERNEL=7.2.8-1-default

echo "=============================================================="
echo " iMac A2115 - configuration verification   $(date -Is)"
echo "=============================================================="
echo " reference: docs/reference-system.md"
echo " changes nothing; safe to run at any time"

# root is needed for /proc/asound, dkms and lsinitrd
if [ "$USE_SUDO" = 1 ]; then
  sudo -n true 2>/dev/null || { SUDO_OK=0; }
  if [ "$SUDO_OK" = 0 ]; then
    printf '\n  [warn] no passwordless sudo; root-only checks will be skipped\n'
    printf '  ->     re-run with a tty, or use --no-sudo deliberately\n'
  fi
fi

#--------------------------------------------------------------- hardware
sec "Hardware"
MODEL=$(cat /sys/class/dmi/id/product_name 2>/dev/null)
case "$MODEL" in
  *iMac*19,1*|*A2115*) ok "iMac 19,1 / A2115 ($MODEL)" ;;
  "")                 warn "could not read product_name (needs root?)" ;;
  *)                  warn "unexpected model: $MODEL - this repo targets iMac19,1" ;;
esac

if [ -r /sys/class/dmi/id/board_version ] 2>/dev/null; then
  info "board: $(cat /sys/class/dmi/id/board_version 2>/dev/null)"
fi

GPU=$(lspci 2>/dev/null | grep -iE 'vga|display controller' | head -1)
if [ -n "$GPU" ]; then
  info "gpu: ${GPU#*: }"
  echo "$GPU" | grep -qiE 'AMD|ATI|Radeon|Ellesmere|polaris' \
    && ok "AMD polaris-class GPU present" \
    || warn "GPU is not an AMD Radeon - the 5K patches target amdgpu"
else
  warn "no display controller found via lspci"
fi

#----------------------------------------------------------------- kernel
sec "Kernel"
K=$(uname -r)
if [ "$K" = "$REF_KERNEL" ]; then ok "$K (reference kernel)"
else warn "$K - verified on $REF_KERNEL only; see docs/distro-matrix.md"; fi

#--------------------------------------------------------------- display
sec "Display - the 5K path"
AMDSRC=$(cat /sys/module/amdgpu/srcversion 2>/dev/null)
if [ -z "$AMDSRC" ]; then
  no "amdgpu is not loaded"
  info "a black display here is expected; see docs/recovery.md"
elif in_list "$AMDSRC" "$REF_PATCHED_SRCV"; then
  ok "patched amdgpu is running ($AMDSRC)"
elif in_list "$AMDSRC" "$REF_STOCK_SRCV"; then
  no "STOCK amdgpu is running ($AMDSRC) - the 5K patch is missing"
  info "a stock amdgpu has no tiled_stitch parameter, so this boots ONE tile"
  info "rebuild it: sudo /usr/local/libexec/imac-amdgpu-install --kver $(uname -r)"
  info "see docs/recovery.md#recovery-2"
else
  warn "amdgpu srcversion $AMDSRC matches neither the reference patched nor stock build"
fi

# the on-disk copy is ALWAYS stock on this machine; do not call it a verdict
DISK=$(modinfo -F filename amdgpu 2>/dev/null)
[ -n "$DISK" ] && info "on-disk copy (expected to be stock): ${DISK##*/}"

TS=$(cat /sys/module/amdgpu/parameters/tiled_stitch 2>/dev/null)
if [ -z "$TS" ]; then
  no "no tiled_stitch parameter - this driver has no 5K support"
elif [ "$TS" = "$REF_STITCH" ]; then
  ok "tiled_stitch=$TS (cmdline and sysfs agree)"
else
  no "tiled_stitch=$TS, expected $REF_STITCH"
  info "the value is set on the kernel command line and needs a reboot"
fi

CMDLINE=$(grep -o 'amdgpu\.tiled_stitch=[^ ]*' /proc/cmdline 2>/dev/null)
case "$CMDLINE" in
  "amdgpu.tiled_stitch=-1") ok "cmdline carries tiled_stitch=-1" ;;
  "")  no "no tiled_stitch on the kernel command line" ;;
  *)   warn "cmdline has $CMDLINE; -1 is the verified value" ;;
esac

# connectors
#
# On a correctly tiled panel there is exactly ONE connected connector: eDP-1,
# carrying the full 5120x2880 framebuffer across both tiles. The slave tile is
# deliberately hidden by imac5k-stitch-hide-slave.patch, so it does NOT appear as
# a second "connected" entry. Counting connectors to decide whether both panels
# are lit therefore reports the healthy state as "one panel is dark", which is
# exactly backwards.
#
# The real test is the framebuffer width below: 5120 means both tiles are live.
NC=0
for f in /sys/class/drm/card*/status; do
  [ "$(cat "$f" 2>/dev/null)" = "connected" ] && NC=$((NC+1))
done
if [ "$NC" -ge 1 ]; then
  ok "$NC connector connected (eDP-1 carries both tiles; slave is hidden by design)"
elif [ "$NC" -eq 0 ]; then no "no connectors connected"; fi

# framebuffer size, from the connector modes
# A connector's modes file holds one WxH per line, optionally tab-separated and
# optionally carrying a _60.000 refresh suffix. Strip both before splitting.
# (An earlier version used `set -- $line` and required two fields, which a bare
# "5120x2880" never satisfies - it silently reported 0x0 for every machine,
# including a correctly tiled one.)
MAXW=0; MAXH=0
for m in /sys/class/drm/card*/modes; do
  [ -r "$m" ] || continue
  while read -r line; do
    line=${line%%$'\t'*}; line=${line%% *}
    case "$line" in *x*) ;; *) continue ;; esac
    geom=${line%%_*}
    w=${geom%%x*}; h=${geom##*x}
    case "${w}${h}" in *[!0-9]*) continue ;; esac
    [ -n "$w" ] && [ -n "$h" ] || continue
    if [ "$h" -gt "$MAXH" ] || { [ "$h" -eq "$MAXH" ] && [ "$w" -gt "$MAXW" ]; }; then
      MAXW=$w; MAXH=$h
    fi
  done < "$m"
done
if [ "$MAXW" -ge 5000 ] 2>/dev/null; then ok "framebuffer reports ${MAXW}x${MAXH}"
elif [ "$MAXW" -gt 0 ] 2>/dev/null; then warn "largest mode is ${MAXW}x${MAXH} - tiling is not joined"
else unk "could not read connector modes"; fi

#----------------------------------------------------------------- audio
sec "Panel brightness"
# The panel only responds when the kernel is booted acpi_backlight=video. The
# default (native) registers amdgpu's backlight instead, which is type "raw",
# writes successfully, and does nothing - so this reads as a hardware fault.
# docs/brightness.md has the full story.
if tr ' ' '\n' < /proc/cmdline | grep -q 'acpi_backlight=video'; then
  ok "acpi_backlight=video on the kernel command line"
else
  no "acpi_backlight=video NOT set - the panel will not respond to brightness"
  info "add it to the options line of both BLS entries (there is no /etc/default/grub here)"
  info "see docs/brightness.md"
fi
PANEL=""
for d in /sys/class/backlight/acpi_video*; do
  [ -w "$d/brightness" ] || continue
  m=$(cat "$d/max_brightness" 2>/dev/null)
  [ "$m" != "100" ] && { PANEL=$d; break; }
done
if [ -n "$PANEL" ]; then
  ok "panel backlight: $(basename "$PANEL") $(cat "$PANEL"/brightness)/$(cat "$PANEL"/max_brightness)"
  info "max_brightness is the firmware's own table (89 levels, not 100) - a firmware cap"
elif ls /sys/class/backlight/amdgpu_bl* >/dev/null 2>&1; then
  no "only amdgpu_bl* present - these are the nodes the panel ignores"
  info "boot with acpi_backlight=video"
else
  no "no backlight device at all"
fi
if [ -x /usr/local/bin/imac-brightness ] && [ -x /usr/local/libexec/imac-brightness-set ]; then
  ok "brightness helpers installed"
  info "KDE's slider works on its own; these are for an exact level and min/max"
else
  info "scripts/imac-audio --helpers installs the brightness helpers"
fi

sec "Audio - the codec path"
DK=$(dkms status 2>/dev/null | grep -i macbookpro)
if [ -n "$DK" ]; then
  ok "DKMS codec registered"
  echo "$DK" | sed 's/^/         /'
  if echo "$DK" | grep -q ", $K,"; then
    ok "a build exists for the running kernel"
  else
    warn "no DKMS build listed for $K - internal speakers may be silent"
    info "sudo scripts/imac-audio --install -k $K"
  fi
else
  no "no DKMS codec registered - internal speakers will be silent"
  info "see docs/audio.md for the driver source and build guards"
fi

# The decisive audio check. The headset capture patch exports 10 module
# parameters; an unpatched driver exports 0. Without it, EarPods capture is
# digital silence even though speakers work fine.
NP=$(ls /sys/module/snd_hda_codec_cs8409/parameters 2>/dev/null | wc -l)
if [ "$NP" -ge 10 ]; then
  ok "headset capture patch is loaded ($NP module parameters)"
elif [ "$NP" -eq 0 ]; then
  no "driver is UNPATCHED (0 parameters) - EarPods capture will be digital silence"
  info "sudo scripts/imac-audio --install"
else
  warn "$NP module parameters - expected 10 if the headset patch is loaded"
fi

CSRC=$(cat /sys/module/snd_hda_codec_cs8409/srcversion 2>/dev/null)
if [ -n "$CSRC" ]; then
  CMOD=$(modinfo -n snd_hda_codec_cs8409 2>/dev/null)
  case "$CMOD" in
    */updates/*) ok "cs8409 codec active from updates/ ($CSRC)" ;;
    "")          info "cs8409 loaded (path not resolvable without root)" ;;
    *)           warn "cs8409 resolves to $CMOD, not an updates/ build" ;;
  esac
else
  warn "snd_hda_codec_cs8409 not loaded"
fi

# internal speaker enumeration: 2ch works, 4ch is the broken one
if [ -r /proc/asound/card1/pcm0c/sub0/status ] 2>/dev/null; then
  ok "capture path open on the internal codec"
else
  info "capture path not readable without root"
fi

#------------------------------------------------------------------ iGPU
sec "iGPU"
GB=$(cat /etc/modprobe.d/99-imac-audio-gpu-bind.conf 2>/dev/null)
case "$GB" in
  *gpu_bind=0*) ok "gpu_bind=0 set - iGPU will not steal HDA audio" ;;
  "")           warn "no gpu_bind=0 in modprobe.d - enabling the iGPU risks the speakers" ;;
  *)            warn "gpu_bind setting present but not the expected 0: $GB" ;;
esac
# A bound i915 is EXPECTED and healthy. The iGPU is deliberately published by the
# set_os-patched kernel so QuickSync/VA-API is available for encoding. It renders
# nothing: every connector on card1 is disconnected and amdgpu owns the panel.
# What actually matters for audio is gpu_bind=0, checked above - the risk is the
# iGPU stealing the HDA controller, not it existing.
if lspci 2>/dev/null | grep -qi 'vga.*Intel'; then
  I915_CONN=0
  for f in /sys/class/drm/card*-*/status; do
    case "$f" in *card1-*) [ "$(cat "$f" 2>/dev/null)" = "connected" ] && I915_CONN=1 ;; esac
  done
  if [ "$I915_CONN" -eq 1 ]; then
    warn "i915 has a CONNECTED connector - it may be driving the panel, not amdgpu"
  else
    ok "iGPU bound to i915 with no connected connector (renders nothing, by design)"
  fi
else
  ok "no Intel display controller bound"
fi

#--------------------------------------------------- never-verified items
sec "Not verified - reported as UNKNOWN, never as OK"
# These have no verified answer on the reference machine. Saying OK would be a
# lie. See docs/reference-system.md.
unk "display tearing - never measured"
unk "cold-boot panel initialisation - known FAULTY (AUX-wake retries); untested this boot"
info "these are open questions, not failures. Do not read them as passing."

#------------------------------------------------------------- bootloader
sec "Boot"
# This machine has two EFI partitions. The BLS entries live on XBOOTLDR and the
# ESP's entries directory is empty, so a hardcoded ESP path silently finds
# nothing. Detect it once instead. See docs/recovery.md.
ENTRYDIR=""
for d in /boot/efi-xbootldr/loader/entries "$ENTRYDIR" \
         /boot/efi/opensuse/loader/entries; do
  [ -d "$d" ] || continue
  if [ -n "$(ls -1 "$d"/*.conf 2>/dev/null)" ]; then ENTRYDIR=$d; break; fi
  [ -z "$ENTRYDIR" ] && ENTRYDIR=$d
done
BLS="$ENTRYDIR"
if [ -d "$BLS" ]; then
  ok "systemd-boot BLS entries present"
  S ls -1 "$BLS" 2>/dev/null | sed 's/^/         /' || info "entries not readable without root"
else
  unk "no $BLS - is this an ESP-mounted system?"
fi
AVAIL=$(df -m --output=avail /boot/efi 2>/dev/null | tail -1 | tr -d ' ')
ESPSZ=$(df -m --output=size /boot/efi 2>/dev/null | tail -1 | tr -d ' ')
if [ -n "$AVAIL" ] && [ -n "$ESPSZ" ]; then
  # The question is not "is there room for a second kernel pair now" - two pairs
  # never fit and never will. It is "will there be room after the ESP is
  # emptied", because imac-update copies the running pair to the XBOOTLDR,
  # verifies it, and only then removes it from the ESP. 150M is what that leaves.
  #
  # An earlier version of this check compared AVAIL against 120 and warned at
  # 93M free, which is exactly the state a healthy machine sits in permanently:
  # the running pair occupies 98M and nothing else is ever there.
  if   [ "$AVAIL" -ge 120 ]; then
    ok "ESP has ${AVAIL}M free (of ${ESPSZ}M)"
  elif [ "$ESPSZ" -ge 150 ] && [ "$AVAIL" -ge 45 ]; then
    ok "ESP has ${AVAIL}M free of ${ESPSZ}M - room for one kernel pair after imac-update empties it"
    info "a second pair never fits; that is why the rollback pair lives on the XBOOTLDR"
  elif [ "$AVAIL" -ge 45 ]; then
    warn "ESP has ${AVAIL}M free of ${ESPSZ}M - an ordinary update fits, a kernel pair may not"
    info "check nothing unexpected is squatting in /boot/efi: du -sh /boot/efi/*"
  else
    no "ESP has only ${AVAIL}M free of ${ESPSZ}M - below the 45M an ordinary update needs"
    info "imac-update will refuse; find what is using the space first"
  fi
fi

#------------------------------------------------------------------ result
sec "Result"
printf '  passed %d   failed %d   warnings %d   unknown %d\n\n' "$PASS" "$FAIL" "$WARN" "$UNK"
if [ "$FAIL" -gt 0 ]; then
  echo "  FAIL - something is not working. See the [FAIL] lines above."
  echo "  If the display is broken, read docs/recovery.md before changing anything."
  exit 1
fi
echo "  PASS - every checkable component is working."
echo "  UNKNOWN lines are untested questions, not failures."
echo "  Paste all of this when reporting an issue."
