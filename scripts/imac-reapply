#!/bin/bash

# Resolve the invoking user's home rather than assuming one, so these scripts run
# for any account rather than only the one they were written on.
UH=${SUDO_USER:-$(logname 2>/dev/null || echo "${USER:-root}")}
UHOME=$(getent passwd "$UH" 2>/dev/null | cut -d: -f6)
[ -n "$UHOME" ] || UHOME="$HOME"

#==============================================================================
# imac-reapply - re-apply all iMac A2115 customisations after a system update
#
#   sudo ~/bin/imac-reapply              # do everything
#   sudo ~/bin/imac-reapply --check      # report only, change nothing
#   sudo ~/bin/imac-reapply --fix-opencl # only the fragile OpenCL part
#
# --fix-X applies section X and skips the rest entirely: kernel, esp, opencl,
# audio, sddm, resolve, boot. --check ignores these and reports every section.
#
# Why: openSUSE Slowroll updates overwrite things, and the two fragile parts
# are handled very differently on purpose:
#
#   audio - the patched CS8409 codec must be rebuilt and reinstalled for every
#           new kernel. Verified on the machine 2026-10-06: DKMS
#           (snd_hda_macbookpro/0.2, jackdanyell + headset patch) is the
#           working configuration and installs
#           into updates/. See docs/audio.md.
#   opencl- GPU compute for Resolve lives in a Flatpak runtime whose hashed
#           path changes on every runtime update. The ICD file is repointed
#           here, but the linker and libclc parts are NOT automated: doing
#           them globally broke the graphical login. See the note in the
#           opencl section.
#==============================================================================
set -uo pipefail

CHECK=0
ONLY=""
for a in "$@"; do
  case "$a" in
    --check) CHECK=1 ;;
    --fix-opencl) ONLY="opencl" ;;
    --fix-boot) ONLY="boot" ;;
    --fix-audio) ONLY="audio" ;;
    --fix-sddm) ONLY="sddm" ;;
    --fix-resolve) ONLY="resolve" ;;
    --fix-kernel)  ONLY="kernel" ;;
    --fix-esp)    ONLY="esp" ;;
  esac
done

LOG=/var/log/imac-reapply.log
say()  { printf '%s\n' "$*" | tee -a "$LOG"; }
ok()   { say "  [ ok ] $*"; }
bad()  { say "  [FAIL] $*"; }
warn() { say "  [warn] $*"; }
hint() { say "    fix:  $*"; }
can()  { [ "$CHECK" -eq 0 ] && { [ -z "$ONLY" ] || [ "$ONLY" = "$1" ]; }; }
sel()  { [ -z "$ONLY" ] || [ "$ONLY" = "$1" ]; }

: > "$LOG"
say "=== imac-reapply $(date -Is)  mode=$([ $CHECK -eq 1 ] && echo check || echo apply) ==="
[ "$(id -u)" -eq 0 ] || { say "must run as root: sudo ~/bin/imac-reapply"; exit 1; }


# This machine has two EFI partitions. The BLS entries live on XBOOTLDR and the
# ESP's entries directory is empty, so a hardcoded ESP path silently finds
# nothing. Detect it once instead. See docs/recovery.md.
ENTRYDIR=""
for d in /boot/efi-xbootldr/loader/entries "$ENTRYDIR" \
         /boot/efi/opensuse/loader/entries; do
  [ -d "$d" ] || continue
  if [ -n "$(ls -1 "$d"/*.conf 2>/dev/null)" ]; then ENTRYDIR=$d; break; fi
  [ -z "$ENTRYDIR" ] && ENTRYDIR=$d
done

#--------------------------------------------------------------------- kernel
if sel kernel; then
say ""; say "[kernel]"
CUR=$(uname -r)
# Kernel versions must be the full module-directory form (7.2.2-1-default).
# rpm's %{VERSION} is only the upstream part (7.2.2) and the release does not
# map cleanly onto the module directory suffix, so comparing against it makes a
# newly installed kernel look identical to the running one - which would hide a
# pending reboot. Read the BLS "version" field instead (1@7.2.2-1-default),
# falling back to the directory of the "linux" path, then to /lib/modules.
# Entries whose kernel directory no longer exists are stale and are dropped.
installed_kernels() {
  local out v
  out=$(awk '/^version[[:space:]]/ { v=$2; sub(/^[^@]*@/, "", v); if (v != "") print v }' \
         "$ENTRYDIR"/*.conf 2>/dev/null | sort -uV)
  if [ -z "$out" ]; then
    out=$(awk '/^linux[[:space:]]/ { for (i=2;i<=NF;i++) if ($i ~ /^\//) { n=split($i,a,"/"); print a[n-1] } }' \
           "$ENTRYDIR"/*.conf 2>/dev/null | sort -uV)
  fi
  if [ -n "$out" ]; then
    for v in $out; do [ -d "/lib/modules/$v" ] && printf '%s\n' "$v"; done
  else
    ls -1 /lib/modules 2>/dev/null | sort -V
  fi
}
say "  running:   $CUR"
K=$(installed_kernels)
NEWEST=$(echo "$K" | tail -1)
say "  installed kernels: $(echo "$K" | tr '\n' ' ')"
if [ "$CUR" = "$NEWEST" ]; then
  ok "running the newest installed kernel ($CUR)"
elif echo "$K" | grep -qx "$CUR"; then
  warn "REBOOT PENDING: running $CUR, newest installed is $NEWEST"
  say "    the patched audio codec and the 5K initrd are per-kernel."
  say "    DKMS rebuilds the codec by itself; confirm a build exists for $NEWEST:"
  say "      dkms status | grep macbookpro"
  say "    If it does not:  sudo scripts/imac-audio --install -k $NEWEST"
  say "    After reboot verify: tiled 5K output, then audio."
else
  warn "running $CUR is not among installed: $(echo "$K" | tr '\n' ' ')"
fi
if [ -f /etc/zypp/constraints.d/kernel-block.const ]; then
  ok "constraint file present (holds kernel-default at the version the patched amdgpu and audio DKMS builds target)"
fi

#------------------------------------------------------------------- ESP space
fi
if sel esp; then
say ""; say "[esp]"
AVAIL=$(df -m --output=avail /boot/efi 2>/dev/null | tail -1 | tr -d ' ')
say "  free: ${AVAIL}M on /boot/efi"
OLD=$(ls -1 "$ENTRYDIR"/ 2>/dev/null | grep -cE 'opensuse-slowroll-.*-(7[0-9]|8[0-9]|9[0-9])\.conf$')
say "  old snapper BLS entries: $OLD"
if [ "${AVAIL:-0}" -lt 60 ]; then
  warn "too tight for a kernel update; prune first:"
  say "    sudo rm -f "$ENTRYDIR"/opensuse-slowroll-*-{70..99}.conf"
elif [ "${AVAIL:-0}" -lt 100 ]; then
  warn "tight; a kernel update may fail"
else
  ok "room for a kernel update"
fi

#------------------------------------------------------------- OpenCL / rusticl
fi

#------------------------------------------------------------------------ audio
if sel audio; then
say ""; say "[desktop safety]"
# Not an OpenCL feature. This global linker entry puts the Flatpak Mesa runtime on
# the system-wide search path and stops KWin starting, so it must never exist.
# Kept after the OpenCL/Resolve sections were removed: it guards the desktop
# itself, not any one application.
if [ -f /etc/ld.so.conf.d/zz-rusticl-runtime.conf ]; then
  bad "global linker entry for the Flatpak runtime is present - this breaks the desktop"
  hint "sudo rm -f /etc/ld.so.conf.d/zz-rusticl-runtime.conf && sudo ldconfig"
fi

say ""; say "[audio]"

# --- HDA runtime power management: the documented cause of total silence ---
# Ref davidjo/snd_hda_macbookpro#209 (iMac19,1) and #217. When the controller
# runtime-suspends, the CS8409's I2C bridge loses power and the CS42L83 /
# TAS5764L amplifiers can never be programmed. Nothing errors; you just get no
# sound at any volume.
PS=$(cat /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null)
PSC=$(cat /sys/module/snd_hda_intel/parameters/power_save_controller 2>/dev/null)
say "  snd_hda_intel power_save=${PS:-?} power_save_controller=${PSC:-?}"
if [ "$PS" = "N" ] && [ "$PSC" = "N" ]; then
  ok "HDA runtime power management disabled"
else
  bad "HDA runtime power management is ENABLED - internal speakers may be silent"
  hint "sudo ~/bin/imac-audio-fix   # writes /etc/modprobe.d/99-imac-audio.conf"
fi

# --- codec module: this is what actually decides whether speakers work ---
if dkms status 2>/dev/null | grep -qi snd_hda_macbookpro; then
  # Not a fault. The loaded snd_hda_codec_cs8409 IS this DKMS build. Expecting
  # its absence here would flag a correctly configured machine.
  #
  # The package is jackdanyell's tree at 0.2, built with the headset capture
  # patch. It is the correct codec for this machine. An earlier version of this
  # script named it as the wrong fork and told you to remove it; that was
  # backwards and would have disabled headset capture.
  ok "CS8409 DKMS codec registered - this is the working codec configuration"
  hint "scripts/imac-audio --check    # confirms the headset patch is actually loaded"
fi
RESOLVED=$(modinfo -n snd_hda_codec_cs8409 2>/dev/null)
say "  cs8409 module: ${RESOLVED:-not found}"
case "$RESOLVED" in
  */updates/*) ok "patched DKMS codec active via updates/" ;;
  "")          bad "no cs8409 module found" ;;
  *)           warn "the in-tree codec wins, not the DKMS build"
               hint "sudo scripts/imac-audio --install" ;;
esac
# Check DKMS directly. scripts/imac-audio-module is retired; it inspected an
# ext01 layout that DKMS beats. See scripts/imac-audio and docs/audio.md.
if dkms status 2>/dev/null | grep -qi macbookpro; then
  dkms status 2>/dev/null | grep -i macbookpro | sed 's/^/  /'
else
  warn "no DKMS codec registered for the CS8409"
  hint "sudo scripts/imac-audio --install   # see docs/audio.md"
fi

# --- PipeWire routing ---
A=$UHOME/.config/pipewire/pipewire.conf.d/90-imac-speakers.conf
if [ -f "$A" ]; then
  U=$(grep -c 'Mult" = 1\.0' "$A")
  if [ "$U" = "6" ]; then ok "6/6 linear stages at unity gain"
  else warn "$U/6 linear stages at unity"; hint "sed -i 's/\"Mult\" = [0-9.]*/\"Mult\" = 1.0/' $A"; fi
  say "  nodes: $(grep -c 'type = builtin' "$A")"
  if [ "$CHECK" -eq 0 ]; then
    V=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
    [ -n "$V" ] && say "  sink: $V"
    case "$V" in *MUTED*) warn "sink is MUTED - unmute before judging audio" ;; esac
  fi
else
  bad "audio chain missing: $A"
fi

#------------------------------------------------------------------------- SDDM
fi
if sel boot; then
say ""; say "[boot]"
DEF=$(awk '/^default[[:space:]]/{print $2; exit}' /boot/efi/loader/loader.conf 2>/dev/null)
TMO=$(awk '/^timeout[[:space:]]/{print $2; exit}' /boot/efi/loader/loader.conf 2>/dev/null)
say "  default: ${DEF:-unset}  timeout: ${TMO:-unset}s"
if [ -n "$DEF" ] && [ -f ""$ENTRYDIR"/$DEF" ]; then
  ok "default entry exists"
  # BLS paths are ESP-relative (no /boot/efi prefix), so resolve them there.
  miss=0
  for p in $(awk '/^(linux|initrd)[[:space:]]/{for(i=2;i<=NF;i++) if($i ~ /^\//) print $i}' \
             ""$ENTRYDIR"/$DEF"); do
    if [ -e "/boot/efi$p" ]; then say "    ok $p"
    else warn "MISSING $p"; miss=1; fi
  done
  [ $miss -eq 0 ] && ok "all kernel/initrd paths resolve under /boot/efi"
else
  bad "default entry missing or unparsable"
fi
say "  theme: $(awk -F= '/^Theme/{print $2; exit}' /etc/plymouth/plymouthd.conf 2>/dev/null)"
say "  known: Plymouth cannot render here - amdgpu needs ~5.2s of firmware" \
    "load before the stitched panel exists. Entries omit rd.plymouth."

fi
say ""
say "=== done; log $LOG ==="
[ $CHECK -eq 1 ] && say "(check mode: nothing changed)"
exit 0
