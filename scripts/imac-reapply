#!/bin/bash

# Resolve the invoking user's home rather than assuming one, so these scripts run
# for any account rather than only the one they were written on.
UH=${SUDO_USER:-$(logname 2>/dev/null || echo "${USER:-root}")}
UHOME=$(getent passwd "$UH" 2>/dev/null | cut -d: -f6)
[ -n "$UHOME" ] || UHOME="$HOME"

#==============================================================================
# imac-reapply - re-apply all iMac A2115 customisations after a system update
#
#   sudo ~/bin/imac-reapply              # do everything
#   sudo ~/bin/imac-reapply --check      # report only, change nothing
#   sudo ~/bin/imac-reapply --fix-opencl # only the fragile OpenCL part
#
# --fix-X applies section X and skips the rest entirely: kernel, esp, opencl,
# audio, sddm, resolve, boot. --check ignores these and reports every section.
#
# Why: openSUSE Slowroll updates overwrite things, and the two fragile parts
# are handled very differently on purpose:
#
#   audio - the patched CS8409 codec must be rebuilt and reinstalled for every
#           new kernel. Verified on the machine 2026-10-06: DKMS
#           (snd-hda-macbookpro/0.1) is the working configuration and installs
#           into updates/. See docs/fixes.md.
#   opencl- GPU compute for Resolve lives in a Flatpak runtime whose hashed
#           path changes on every runtime update. The ICD file is repointed
#           here, but the linker and libclc parts are NOT automated: doing
#           them globally broke the graphical login. See the note in the
#           opencl section.
#==============================================================================
set -uo pipefail

CHECK=0
ONLY=""
for a in "$@"; do
  case "$a" in
    --check) CHECK=1 ;;
    --fix-opencl) ONLY="opencl" ;;
    --fix-boot) ONLY="boot" ;;
    --fix-audio) ONLY="audio" ;;
    --fix-sddm) ONLY="sddm" ;;
    --fix-resolve) ONLY="resolve" ;;
    --fix-kernel)  ONLY="kernel" ;;
    --fix-esp)    ONLY="esp" ;;
  esac
done

LOG=/var/log/imac-reapply.log
say()  { printf '%s\n' "$*" | tee -a "$LOG"; }
ok()   { say "  [ ok ] $*"; }
bad()  { say "  [FAIL] $*"; }
warn() { say "  [warn] $*"; }
hint() { say "    fix:  $*"; }
can()  { [ "$CHECK" -eq 0 ] && { [ -z "$ONLY" ] || [ "$ONLY" = "$1" ]; }; }
sel()  { [ -z "$ONLY" ] || [ "$ONLY" = "$1" ]; }

: > "$LOG"
say "=== imac-reapply $(date -Is)  mode=$([ $CHECK -eq 1 ] && echo check || echo apply) ==="
[ "$(id -u)" -eq 0 ] || { say "must run as root: sudo ~/bin/imac-reapply"; exit 1; }

#--------------------------------------------------------------------- kernel
if sel kernel; then
say ""; say "[kernel]"
CUR=$(uname -r)
# Kernel versions must be the full module-directory form (7.2.2-1-default).
# rpm's %{VERSION} is only the upstream part (7.2.2) and the release does not
# map cleanly onto the module directory suffix, so comparing against it makes a
# newly installed kernel look identical to the running one - which would hide a
# pending reboot. Read the BLS "version" field instead (1@7.2.2-1-default),
# falling back to the directory of the "linux" path, then to /lib/modules.
# Entries whose kernel directory no longer exists are stale and are dropped.
installed_kernels() {
  local out v
  out=$(awk '/^version[[:space:]]/ { v=$2; sub(/^[^@]*@/, "", v); if (v != "") print v }' \
         /boot/efi/loader/entries/*.conf 2>/dev/null | sort -uV)
  if [ -z "$out" ]; then
    out=$(awk '/^linux[[:space:]]/ { for (i=2;i<=NF;i++) if ($i ~ /^\//) { n=split($i,a,"/"); print a[n-1] } }' \
           /boot/efi/loader/entries/*.conf 2>/dev/null | sort -uV)
  fi
  if [ -n "$out" ]; then
    for v in $out; do [ -d "/lib/modules/$v" ] && printf '%s\n' "$v"; done
  else
    ls -1 /lib/modules 2>/dev/null | sort -V
  fi
}
say "  running:   $CUR"
K=$(installed_kernels)
NEWEST=$(echo "$K" | tail -1)
say "  installed kernels: $(echo "$K" | tr '\n' ' ')"
if [ "$CUR" = "$NEWEST" ]; then
  ok "running the newest installed kernel ($CUR)"
elif echo "$K" | grep -qx "$CUR"; then
  warn "REBOOT PENDING: running $CUR, newest installed is $NEWEST"
  say "    the patched audio codec and the 5K initrd are per-kernel."
  say "    DKMS rebuilds the codec by itself; confirm a build exists for $NEWEST:"
  say "      dkms status | grep macbookpro"
  say "    If it does not:  sudo dkms install --force snd-hda-macbookpro/0.1 -k $NEWEST"
  say "    After reboot verify: tiled 5K output, then audio."
else
  warn "running $CUR is not among installed: $(echo "$K" | tr '\n' ' ')"
fi
if [ -f /etc/zypp/constraints.d/kernel-block.const ]; then
  ok "constraint file present (holds kernel-default at the version the patched amdgpu and audio DKMS builds target)"
fi

#------------------------------------------------------------------- ESP space
fi
if sel esp; then
say ""; say "[esp]"
AVAIL=$(df -m --output=avail /boot/efi 2>/dev/null | tail -1 | tr -d ' ')
say "  free: ${AVAIL}M on /boot/efi"
OLD=$(ls -1 /boot/efi/loader/entries/ 2>/dev/null | grep -cE 'opensuse-slowroll-.*-(7[0-9]|8[0-9]|9[0-9])\.conf$')
say "  old snapper BLS entries: $OLD"
if [ "${AVAIL:-0}" -lt 60 ]; then
  warn "too tight for a kernel update; prune first:"
  say "    sudo rm -f /boot/efi/loader/entries/opensuse-slowroll-*-{70..99}.conf"
elif [ "${AVAIL:-0}" -lt 100 ]; then
  warn "tight; a kernel update may fail"
else
  ok "room for a kernel update"
fi

#------------------------------------------------------------- OpenCL / rusticl
fi
if sel opencl; then
say ""; say "[opencl]"
  ICD=/etc/OpenCL/vendors/rusticl.icd
  LIB=$(find /var/lib/flatpak/runtime -name 'libRusticlOpenCL.so.1' 2>/dev/null | head -1)
  if [ -z "$LIB" ]; then
    bad "no rusticl driver anywhere under /var/lib/flatpak/runtime"
    hint "flatpak install org.freedesktop.Platform.GL//25.08   # or any GL-using app"
  else
    CUR_ICD=$(cat "$ICD" 2>/dev/null)
    if [ "$CUR_ICD" = "$LIB" ]; then
      ok "rusticl ICD current"
    else
      say "  ICD needs repointing:"
      say "    was: ${CUR_ICD:-(missing)}"
      say "    now: $LIB"
      if can opencl; then
        mkdir -p /etc/OpenCL/vendors
        printf '%s\n' "$LIB" > "$ICD"
        ok "ICD repointed"
      fi
    fi
    # DELIBERATELY NOT AUTOMATED.
    #
    # An earlier version of this script made GPU OpenCL work by putting the
    # Flatpak runtime on the *global* linker search path and by staging libclc
    # bitcode at /usr/lib/x86_64-linux-gnu/GL/default/share/clc. Both broke the
    # graphical login: KWin would not start because Mesa resolved to the wrong
    # runtime. Recovery meant deleting /usr/lib/x86_64-linux-gnu/GL, removing
    # the ld.so.conf.d drop-in and rebuilding the ld cache.
    #
    # A global ld.so.conf entry cannot be scoped to one application, so this
    # script will not create one again. GPU OpenCL for Resolve has to come
    # from a per-process wrapper, not a system-wide linker change.
  fi
  # The dangerous leftover is the global linker entry. That one put Flatpak Mesa
  # on the system-wide search path and stopped KWin starting, so it must never
  # exist. LD_LIBRARY_PATH inside resolve-200 is the supported mechanism.
  if [ -f /etc/ld.so.conf.d/zz-rusticl-runtime.conf ]; then
    bad "global linker entry for the Flatpak runtime is present - this breaks the desktop"
    hint "sudo rm -f /etc/ld.so.conf.d/zz-rusticl-runtime.conf && sudo ldconfig"
  fi

  # /usr/lib/x86_64-linux-gnu/GL/default/share/clc is a hardcoded *Debian* path
  # rusticl looks in for libclc bitcode; it has no environment override. Two
  # inert .spv data files are staged there on purpose. Anything else in that
  # tree - especially a library - would be a leftover from the broken attempt.
  CLCD=/usr/lib/x86_64-linux-gnu/GL/default/share/clc
  if [ -d /usr/lib/x86_64-linux-gnu/GL ]; then
    STRAY=$(find /usr/lib/x86_64-linux-gnu/GL -type f ! -name '*.spv' 2>/dev/null | head -5)
    if [ -n "$STRAY" ]; then
      bad "non-bitcode files under the staged libclc path:"
      printf '%s\n' "$STRAY" | sed 's/^/    /'
      hint "sudo rm -rf /usr/lib/x86_64-linux-gnu/GL"
    elif [ -f "$CLCD/spirv-mesa3d-.spv" ]; then
      ok "libclc bitcode staged (data only, shadows nothing on openSUSE)"
    fi
  else
    warn "libclc bitcode not staged; rusticl will fail to load"
    hint "copy spirv-mesa3d-.spv and spirv64-mesa3d-.spv from the Flatpak"
    hint "GL runtime into $CLCD"
  fi

  # clinfo must be run the way the launcher runs it, otherwise it reports no
  # GPU even when Resolve has one.
  if command -v clinfo >/dev/null; then
    RT=""
    if [ -r "$ICD" ]; then
      D=$(cat "$ICD" 2>/dev/null | head -1)
      [ -e "$D" ] && RT=$(dirname "$D")
    fi
    CI=$(LD_LIBRARY_PATH="$RT" RUSTICL_ENABLE=radeonsi clinfo 2>/dev/null)
    NGPU=$(printf '%s\n' "$CI" | grep -cE "Device Type +GPU")
    if [ "${NGPU:-0}" -ge 1 ]; then
      ok "GPU OpenCL present"
      printf '%s\n' "$CI" | grep -E "Device Name|Device Type|Max compute" | head -3 | sed 's/^/    /'
    elif printf '%s\n' "$CI" | grep -q rusticl; then
      warn "rusticl loaded but advertises no GPU (RUSTICL_ENABLE not honoured?)"
    else
      warn "no GPU OpenCL device; Resolve will use CPU"
    fi
  fi
fi

#------------------------------------------------------------------------ audio
if sel audio; then
say ""; say "[audio]"

# --- HDA runtime power management: the documented cause of total silence ---
# Ref davidjo/snd_hda_macbookpro#209 (iMac19,1) and #217. When the controller
# runtime-suspends, the CS8409's I2C bridge loses power and the CS42L83 /
# TAS5764L amplifiers can never be programmed. Nothing errors; you just get no
# sound at any volume.
PS=$(cat /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null)
PSC=$(cat /sys/module/snd_hda_intel/parameters/power_save_controller 2>/dev/null)
say "  snd_hda_intel power_save=${PS:-?} power_save_controller=${PSC:-?}"
if [ "$PS" = "N" ] && [ "$PSC" = "N" ]; then
  ok "HDA runtime power management disabled"
else
  bad "HDA runtime power management is ENABLED - internal speakers may be silent"
  hint "sudo ~/bin/imac-audio-fix   # writes /etc/modprobe.d/99-imac-audio.conf"
fi

# --- codec module: this is what actually decides whether speakers work ---
if dkms status 2>/dev/null | grep -qi snd_hda_macbookpro; then
  # Not a fault. Confirmed on the machine 2026-10-06: dkms status reports
  # snd-hda-macbookpro/0.1 installed, and the loaded snd_hda_codec_cs8409 IS
  # that DKMS build (srcversion 5957235DD0C11693189E2C5). Expecting its absence
  # here would flag a correctly configured machine.
  ok "davidjo DKMS driver registered - this is the working codec configuration"
  hint "sudo dkms remove snd_hda_macbookpro/0.2 --all   # DKMS cannot win module ordering"
fi
RESOLVED=$(modinfo -n snd_hda_codec_cs8409 2>/dev/null)
say "  cs8409 module: ${RESOLVED:-not found}"
case "$RESOLVED" in
  */updates/*) ok "patched DKMS codec active via updates/" ;;
  "")          bad "no cs8409 module found" ;;
  *)           warn "the in-tree codec wins, not the DKMS build"
               hint "sudo dkms install --force snd-hda-macbookpro/0.1" ;;
esac
# Check DKMS directly instead of delegating to scripts/imac-audio-module
# --check, which inspected the ext01 layout that DKMS beats. That script is
# SUPERSEDED; the codec path is DKMS. See docs/fixes.md.
if dkms status 2>/dev/null | grep -qi macbookpro; then
  dkms status 2>/dev/null | grep -i macbookpro | sed 's/^/  /'
else
  warn "no DKMS codec registered for the CS8409"
  hint "sudo dkms install --force snd-hda-macbookpro/0.1   # see docs/fixes.md"
fi

# --- PipeWire routing ---
A=$UHOME/.config/pipewire/pipewire.conf.d/90-imac-speakers.conf
if [ -f "$A" ]; then
  U=$(grep -c 'Mult" = 1\.0' "$A")
  if [ "$U" = "6" ]; then ok "6/6 linear stages at unity gain"
  else warn "$U/6 linear stages at unity"; hint "sed -i 's/\"Mult\" = [0-9.]*/\"Mult\" = 1.0/' $A"; fi
  say "  nodes: $(grep -c 'type = builtin' "$A")"
  if [ "$CHECK" -eq 0 ]; then
    V=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
    [ -n "$V" ] && say "  sink: $V"
    case "$V" in *MUTED*) warn "sink is MUTED - unmute before judging audio" ;; esac
  fi
else
  bad "audio chain missing: $A"
fi

#------------------------------------------------------------------------- SDDM
fi
if sel sddm; then
say ""; say "[sddm greeter]"
# The greeter is fixed by a DPI-deriving DisplayCommand wrapper, NOT by
# QT_SCALE_FACTOR: the greeter runs on Xorg at 96 DPI on a 5K panel.
# The greeter is Qt6 on Wayland (kwin_wayland). Scale it with these keys -
# verified working 2026-10-04.
#
# Two traps this check exists to catch:
#   * GreeterEnvironment separates variables with COMMAS. A semicolon makes SDDM
#     discard the whole string silently, which looks like the setting does
#     nothing at all.
#   * EnableHiDPI is read from [Wayland] and [X11], NOT [Theme] as the
#     sddm.conf(5) man page implies.
say "  --- greeter (Qt6 / Wayland) ---"
GE=""
HIDPI=0
for f in /etc/sddm.conf /etc/sddm.conf.d/*.conf; do
  [ -f "$f" ] || continue
  g=$(awk '/^\[General\]/{t=1;next} /^\[/{t=0} t&&/^GreeterEnvironment=/{print;exit}' "$f" 2>/dev/null)
  [ -n "$g" ] && GE="$g"
  if grep -qE '^EnableHiDPI=true' "$f" 2>/dev/null; then HIDPI=1; fi
done
if [ -n "$GE" ]; then
  ok "GreeterEnvironment set: $(echo "$GE" | cut -c1-64)"
  case "$GE" in
    *";"*) bad "GreeterEnvironment uses SEMICOLONS - SDDM needs COMMAS"
           hint "separate the variables with , instead of ;" ;;
    *",QT_"*) ok "comma-separated (correct for SDDM)" ;;
    *)       warn "only one variable present - if scaling is still wrong, check the separators" ;;
  esac
  case "$GE" in
    *QT_SCREEN_SCALE_FACTORS*) ok "Qt6 scale factor present for the greeter" ;;
    *) warn "QT_SCREEN_SCALE_FACTORS missing from GreeterEnvironment" ;;
  esac
else
  bad "GreeterEnvironment not set - the greeter will render at 100%"
  hint "in [General]: GreeterEnvironment=QT_SCREEN_SCALE_FACTORS=2.0,QT_FONT_DPI=192"
fi
if [ "$HIDPI" -eq 1 ]; then
  ok "EnableHiDPI=true present (must be in [Wayland] and/or [X11], not [Theme])"
else
  bad "EnableHiDPI=true not set"
  hint "set it under [Wayland] and [X11]"
fi
# session restore reopens every window at login.
KSMRC=$UHOME/.config/ksmserverrc
if grep -qx 'restoreOnLogin=false' "$KSMRC" 2>/dev/null; then
  ok "session restore disabled (windows will not reopen at login)"
else
  warn "session restore still enabled - windows reopen at login"
  hint "printf '\\n[Session]\\nrestoreOnLogin=false\\n' >> $KSMRC"
fi
say "  applies at next login (never restart sddm mid-session)"

#--------------------------------------------------------------------- resolve
fi
if sel resolve; then
say ""; say "[resolve]"
if [ -d /opt/resolve ]; then
  ok "installed"
  [ -x /usr/local/bin/resolve-200 ] && ok "200% wrapper present" || warn "wrapper missing"
  # Resolve is Qt 5.15 under XWayland: QT_SCALE_FACTOR is ignored for widget
  # geometry unless high-DPI scaling is explicitly enabled. Check both the
  # wrapper and the desktop entry (which now carries the vars inline).
  DE=/usr/share/applications/com.blackmagicdesign.resolve.desktop
  # strip only the leading "Exec=" - the value itself contains '=' characters
  EXEC=$(sed -n 's/^Exec=//p' "$DE" 2>/dev/null | head -1)
  if printf '%s' "$EXEC" | grep -q "QT_ENABLE_HIGHDPI_SCALING=1" \
     && printf '%s' "$EXEC" | grep -q "QT_SCALE_FACTOR=2"; then
    ok "desktop entry carries the Qt5 high-DPI vars"
  elif printf '%s' "$EXEC" | grep -q "resolve-200"; then
    ok "desktop entry uses the scaled wrapper"
  else
    warn "desktop entry launches unscaled"
    hint "Exec should set QT_ENABLE_HIGHDPI_SCALING=1 and QT_SCALE_FACTOR=2"
  fi
  if [ -x /usr/local/bin/resolve-200 ] \
     && ! grep -q QT_ENABLE_HIGHDPI_SCALING /usr/local/bin/resolve-200; then
    warn "wrapper lacks QT_ENABLE_HIGHDPI_SCALING=1 - Resolve will stay 100%"
  fi
  # Resolve bundles its own APR, but the installer check needs the sonames.
  # Use absolute paths: sudo -S sessions can have a minimal PATH.
  LDC=$(command -v ldconfig 2>/dev/null)
  [ -x "$LDC" ] || for c in /usr/sbin/ldconfig /sbin/ldconfig /usr/bin/ldconfig; do
    [ -x "$c" ] && { LDC=$c; break; }; done
  [ -x "$LDC" ] || LDC=ldconfig
  # Read the cache once. `grep -q` in a pipeline under `set -o pipefail`
  # returns 141 (SIGPIPE) even on a match, so avoid -q and test the output.
  CACHE_OUT=$("$LDC" -p 2>/dev/null || true)
  for so in libapr-1 libaprutil-1; do
    # match the soname field exactly (tab + name + space) so libapr-1
    # cannot accidentally match libaprutil-1
    HIT=$(printf '%s\n' "$CACHE_OUT" | grep -E "	${so}\.so\.0 " || true)
    if [ -n "$HIT" ]; then
      ok "$so.so.0 -> ${HIT##*=> }"
    elif [ -e "/usr/local/lib/$so.so.0" ]; then
      warn "$so.so.0 on disk but not in ld.so.cache - run: $LDC"
    else
      warn "$so.so.0 missing (installer package check would fail)"
    fi
  done
else
  warn "not installed"
fi

#-------------------------------------------------------------------- plymouth
fi
if sel boot; then
say ""; say "[boot]"
DEF=$(awk '/^default[[:space:]]/{print $2; exit}' /boot/efi/loader/loader.conf 2>/dev/null)
TMO=$(awk '/^timeout[[:space:]]/{print $2; exit}' /boot/efi/loader/loader.conf 2>/dev/null)
say "  default: ${DEF:-unset}  timeout: ${TMO:-unset}s"
if [ -n "$DEF" ] && [ -f "/boot/efi/loader/entries/$DEF" ]; then
  ok "default entry exists"
  # BLS paths are ESP-relative (no /boot/efi prefix), so resolve them there.
  miss=0
  for p in $(awk '/^(linux|initrd)[[:space:]]/{for(i=2;i<=NF;i++) if($i ~ /^\//) print $i}' \
             "/boot/efi/loader/entries/$DEF"); do
    if [ -e "/boot/efi$p" ]; then say "    ok $p"
    else warn "MISSING $p"; miss=1; fi
  done
  [ $miss -eq 0 ] && ok "all kernel/initrd paths resolve under /boot/efi"
else
  bad "default entry missing or unparsable"
fi
say "  theme: $(awk -F= '/^Theme/{print $2; exit}' /etc/plymouth/plymouthd.conf 2>/dev/null)"
say "  untested: Plymouth has never rendered on the tiled 5K panel"

fi
say ""
say "=== done; log $LOG ==="
[ $CHECK -eq 1 ] && say "(check mode: nothing changed)"
exit 0
