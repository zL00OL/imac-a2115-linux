#!/bin/bash

# Resolve the invoking user's home rather than assuming one, so these scripts run
# for any account rather than only the one they were written on.
UH=${SUDO_USER:-$(logname 2>/dev/null || echo "${USER:-root}")}
UHOME=$(getent passwd "$UH" 2>/dev/null | cut -d: -f6)
[ -n "$UHOME" ] || UHOME="$HOME"

#==============================================================================
# imac-update - update openSUSE on this iMac and re-apply every local patch
#
#   sudo ~/bin/imac-update              # full update, keep current kernel
#   sudo ~/bin/imac-update --dry-run    # show what would happen, change nothing
#   sudo ~/bin/imac-update --kernel     # ALSO move to the newest kernel
#   sudo ~/bin/imac-update --reboot     # reboot at the end (asks first)
#
# Order matters: prune ESP -> update -> rebuild the audio codec for whatever
# kernel is now newest -> re-apply -> (reboot).
#
# The audio step is not optional. The patched CS8409 codec is built per kernel
# into updates/ext01 (see imac-audio-module for why DKMS is not used), so a new
# kernel boots with no patched codec and the internal speakers are silent.
#==============================================================================
set -uo pipefail

DRY=0; WANT_KERNEL=0; DO_REBOOT=0
for a in "$@"; do
  case "$a" in
    --dry-run|--check) DRY=1 ;;
    --kernel)          WANT_KERNEL=1 ;;
    --reboot)          DO_REBOOT=1 ;;
  esac
done

LOG=/var/log/imac-update.log
# This runs under sudo, so ~ is /root and not the user's home. Use an explicit
# path or the script silently reports the helpers as missing.
BIN=$UHOME/bin
say()  { printf '%s\n' "$*" | tee -a "$LOG"; }
step() { say ""; say "=== $* ==="; }
ok()   { say "  [ ok ] $*"; }
warn() { say "  [warn] $*"; }
bad()  { say "  [FAIL] $*"; }
hint() { say "    fix:  $*"; }
die()  { say "ABORT: $*"; say "see $LOG"; exit 1; }

# Kernel versions must be the full module-directory form (7.2.2-1-default).
# rpm's %{VERSION} is only the upstream part (7.2.2) and the release does not
# map cleanly onto the module directory suffix, so comparing against it makes a
# newly installed kernel look identical to the running one - which would hide a
# pending reboot. Read the BLS "version" field instead (1@7.2.2-1-default),
# falling back to the directory of the "linux" path, then to /lib/modules.
# Entries whose kernel directory no longer exists are stale and are dropped.
installed_kernels() {
  local out v
  out=$(awk '/^version[[:space:]]/ { v=$2; sub(/^[^@]*@/, "", v); if (v != "") print v }' \
         /boot/efi/loader/entries/*.conf 2>/dev/null | sort -uV)
  if [ -z "$out" ]; then
    out=$(awk '/^linux[[:space:]]/ { for (i=2;i<=NF;i++) if ($i ~ /^\//) { n=split($i,a,"/"); print a[n-1] } }' \
           /boot/efi/loader/entries/*.conf 2>/dev/null | sort -uV)
  fi
  if [ -n "$out" ]; then
    for v in $out; do [ -d "/lib/modules/$v" ] && printf '%s\n' "$v"; done
  else
    ls -1 /lib/modules 2>/dev/null | sort -V
  fi
}

: > "$LOG"
say "############ imac-update $(date -Is)  dry=$DRY kernel=$WANT_KERNEL ############"
[ "$(id -u)" -eq 0 ] || { say "run with sudo"; exit 1; }

ESP_MIN_KERNEL=120   # M needed to install a kernel alongside existing initrds
ESP_MIN_PATCH=45     # M needed for a non-kernel update

#---------------------------------------------------------------- 0. preflight
step "0. preflight"
AVAIL=$(df -m --output=avail /boot/efi | tail -1 | tr -d ' ')
say "  ESP free: ${AVAIL}M"
say "  running kernel: $(uname -r)"
say "  BLS entries: $(ls -1 /boot/efi/loader/entries/ 2>/dev/null | wc -l)"

if [ -f /etc/zypp/constraints.d/kernel-block.const ]; then
  say "  kernel constraint ACTIVE (holding the kernel at the version the patched amdgpu and audio DKMS builds were made for - see docs/kernel-updates.md)"
  # --kernel lifts the constraint, which means the next kernel may be one the
  # 6-patch amdgpu stack has never been built against. The patch is verified for
  # 7.1.x-7.2.x only, and a stock amdgpu has no tiled_stitch parameter at all -
  # so an unbuilt kernel means no second tile. Say so loudly at this point,
  # before anything is changed, rather than after.
  warn "lifting the kernel constraint: the 5K patches are verified for 7.1.x-7.2.x ONLY"
  warn "you will need a patched amdgpu built into an initramfs for the new kernel - see docs/kernel-updates.md"
  warn "until that exists, booting the new kernel costs you the 5K panel"
else
  say "  kernel constraint absent"
fi

if [ "$DRY" -eq 1 ]; then
  say ""
  say "  [dry-run] would: prune stale BLS entries, run 'zypper up',"
  say "  [dry-run] rebuild the audio codec for the newest kernel,"
  say "  [dry-run] re-run imac-reapply, and report."
  say ""
  say "  audio codec status for the newest kernel:"
  "$BIN/imac-audio-module" --check 2>/dev/null | grep -E '\[(warn|FAIL|ok)\]' | sed 's/^/    /' \
    || say "    (imac-audio-module not installed)"
  say ""
  say "  pending updates:"
  zypper --non-interactive list-updates 2>/dev/null | head -30 | sed 's/^/    /' \
    || say "    (could not query)"
  say ""
  say "  re-apply would report:"
  "$BIN/imac-reapply" --check 2>/dev/null | grep -E "\[(warn|FAIL)\]" | sed 's/^/    /' \
    || say "    (all clean)"
  say ""
  say "  dry run complete; nothing changed."
  exit 0
fi

#----------------------------------------- 1. free ESP space before touching zypper
step "1. ESP space"

# Decide how much we need BEFORE deleting anything.
CURV=$(uname -r)
NEED=$ESP_MIN_PATCH
[ "$WANT_KERNEL" -eq 1 ] && NEED=$ESP_MIN_KERNEL
AVAIL=$(df -m --output=avail /boot/efi | tail -1 | tr -d ' ')
say "  need ${NEED}M, have ${AVAIL}M"

# Snapshot every entry first. These BLS files are regenerable metadata, but a
# backup means a mistake here is always reversible.
SAVEDIR=$UHOME/5k-stackC-backup/esp-prune-$(date +%Y%m%d-%H%M%S)
mkdir -p "$SAVEDIR"
cp -p /boot/efi/loader/entries/*.conf "$SAVEDIR/" 2>/dev/null
say "  backed up all BLS entries to $SAVEDIR"

# Prune ONLY snapper entries numbered >= 70. Never touches 5k-stackc-* entries
# and never touches the loader default, so there is always a bootable fallback.
prune_entries() {
  for f in $(ls -1 /boot/efi/loader/entries/ 2>/dev/null \
             | grep -E '^opensuse-slowroll-.*-(7[0-9]|8[0-9]|9[0-9])\.conf$'); do
    rm -f "/boot/efi/loader/entries/$f"
  done
}

if [ "$AVAIL" -lt "$NEED" ]; then
  say "  not enough space; pruning stale snapper entries"
  PRUNE=$(ls -1 /boot/efi/loader/entries/ 2>/dev/null \
          | grep -cE '^opensuse-slowroll-.*-(7[0-9]|8[0-9]|9[0-9])\.conf$')
  say "  candidates: $PRUNE"
  if [ "$PRUNE" -eq 0 ]; then
    die "ESP too small (${AVAIL}M < ${NEED}M) and no prunable snapper entries left.
  Free space on /boot/efi manually, or the update cannot proceed safely."
  fi
  prune_entries
  AVAIL=$(df -m --output=avail /boot/efi | tail -1 | tr -d ' ')
  say "  ESP free now: ${AVAIL}M"
  if [ "$AVAIL" -lt "$NEED" ]; then
    die "still only ${AVAIL}M after pruning $PRUNE entries; need ${NEED}M.
  Restore with:  cp -p $SAVEDIR/*.conf /boot/efi/loader/entries/
  Nothing has been updated; the system is unchanged apart from the pruned
  (backed-up) BLS files."
  fi
  say "  pruned $PRUNE entries (backed up)"
else
  say "  enough space; nothing pruned"
fi

# Sanity: the default entry and at least one kernel/initrd must still exist.
CUR_ENTRY=$(sed -n 's/^default=//p;/^default[[:space:]]/s/^default[[:space:]]*//p' \
            /boot/efi/loader/loader.conf 2>/dev/null | head -1)
say "  default boot entry: ${CUR_ENTRY:-unset}"
if [ -n "$CUR_ENTRY" ] && [ ! -f "/boot/efi/loader/entries/$CUR_ENTRY" ]; then
  say "  restoring: default entry $CUR_ENTRY is missing"
  cp -p "$SAVEDIR/$CUR_ENTRY" /boot/efi/loader/entries/ 2>/dev/null \
    && say "  restored $CUR_ENTRY" \
    || die "default boot entry $CUR_ENTRY missing and unrestorable from $SAVEDIR"
fi
[ "$(ls -1 /boot/efi/loader/entries/ 2>/dev/null | wc -l)" -gt 0 ] \
  || die "no BLS entries left at all - restore from $SAVEDIR"

#--------------------------------------------------------- 2. kernel decision
step "2. kernel policy"
say "  running kernel version: $CURV"
if [ "$WANT_KERNEL" -eq 1 ]; then
  say "  --kernel given: removing the kernel constraint"
  rm -f /etc/zypp/constraints.d/kernel-block.const
  say "  constraint removed"
else
  say "  keeping the current kernel (constraint stays in place)"
fi

#------------------------------------------------------------------ 3. zypper
step "3. update packages"
say "  refreshing repos"
zypper --non-interactive refresh 2>&1 | tail -5 | sed 's/^/  /'
say "  running: zypper up"
zypper --non-interactive up 2>&1 | tail -25 | sed 's/^/  /'
ZRC=${PIPESTATUS[0]}
say "  zypper exit: $ZRC"
# zypper returns advisory codes that mean "succeeded, but":
#   100 = reboot needed
#   102 = restart zypper recommended
#   103 = reboot and restart recommended
# A kernel update returns one of these routinely. Treating them as fatal aborted
# the run BEFORE the audio codec was rebuilt for the new kernel - worst possible
# moment to stop.
case "$ZRC" in
  0)   say "  zypper exit: 0 (clean)" ;;
  100) say "  zypper exit: 100 - reboot needed, continuing with the rebuild" ;;
  102) say "  zypper exit: 102 - zypper restart recommended, continuing" ;;
  103) say "  zypper exit: 103 - reboot + zypper restart recommended, continuing" ;;
  *)   die "zypper exited $ZRC - inspect the output above before continuing" ;;
esac

# re-check ESP: zypper may have consumed it (new packages with kernel modules)
AVAIL=$(df -m --output=avail /boot/efi | tail -1 | tr -d ' ')
say "  ESP free after update: ${AVAIL}M"

#------------------------------------------- 4. did the kernel actually move?
step "4. kernel status"
NEWEST2=$(installed_kernels | tail -1)
say "  running:  $CURV"
say "  newest installed: $NEWEST2"
say "  installed: $(installed_kernels | tr '\n' ' ')"
if [ "$CURV" = "$NEWEST2" ]; then
  say "  same kernel: a reboot is optional"
else
  say "  NEW KERNEL INSTALLED - a reboot is REQUIRED to activate it"
  say "  after reboot, verify: 5K tiled output, audio, then sudo ~/bin/imac-reapply --check"
fi

#------------------------------- 4b. rebuild the audio codec for the new kernel
# The patched CS8409 codec lives in updates/ext01 and is per-kernel. A new
# kernel has no copy, so it must be rebuilt and installed or the speakers go
# silent after the reboot. This has to happen for the kernel that will be
# booted, not the one currently running.
step "4b. audio codec module for kernel $NEWEST2"
AM="$BIN/imac-audio-module"
if [ -x "$AM" ]; then
  # Rebuilding is only needed when the kernel actually moved. If it did not,
  # and a DKMS driver is already registered, rebuilding risks replacing a
  # working module with one built from a mismatched source tree.
  if [ "$CURV" = "$NEWEST2" ]; then
    if dkms status 2>/dev/null | grep -qi macbookpro; then
      say "  kernel unchanged and the DKMS driver rebuilds itself per kernel;"
      say "  skipping the rebuild so a working module is not replaced."
      say "  status: $(dkms status | grep -i macbookpro | head -1)"
    else
      say "  kernel unchanged; ensuring a codec module is present"
      "$AM" --kernel "$NEWEST2" 2>&1 | sed 's/^/  /'
      [ "${PIPESTATUS[0]}" -ne 0 ] && warn "codec module check/build reported problems"
    fi
  else
    "$AM" --kernel "$NEWEST2" 2>&1 | sed 's/^/  /'
    ARC=${PIPESTATUS[0]}
    if [ "$ARC" -ne 0 ]; then
      warn "the audio module could not be built for $NEWEST2 (rc=$ARC)"
      warn "the speakers WILL be silent after rebooting into it"
      say "  see /var/log/imac-audio-module.log"
    fi
  fi
else
  bad "$AM missing - the audio codec will NOT be rebuilt for the new kernel"
  hint "install scripts/imac-audio-module as ~/bin/imac-audio-module"
fi

#------------------------------------------------- 5. per-package restarts
step "5. services"
# A new kernel or a kernel module needs modules reloaded; the display is XWayland
# under Plasma so a full reboot is the honest way. Log what was installed.
say "  packages installed/updated in this run:"
rpm -qa --last 2>/dev/null | head -0  # (informational only)
say "  NOTE: not restarting services automatically - the session is live."
say "  If a kernel module changed, reboot rather than reload it."

#--------------------------------------------------------- 6. re-apply patches
step "6. re-apply local patches"
if [ -x "$BIN/imac-reapply" ]; then
  "$BIN/imac-reapply" 2>&1 | sed 's/^/  /'
  say "  re-apply finished"
else
  say "  $BIN/imac-reapply MISSING - patches NOT re-applied!"
fi

step "7. final verification"
"$BIN/imac-reapply" --check 2>&1 | grep -E "\[(warn|FAIL)\]" | sed 's/^/  /' \
  || say "  all checks pass"

#------------------------------------------------------------------ 8. reboot
if [ "$DO_REBOOT" -eq 1 ]; then
  say ""
  read -rp "Reboot now? [y/N] " a
  [ "$a" = "y" ] && { say "rebooting"; reboot; } || say "not rebooting"
else
  say ""
  say "No reboot performed. When you do reboot, verify the 5K tiled output."
fi

say ""
say "############ done $(date -Is) - log: $LOG ############"
exit 0