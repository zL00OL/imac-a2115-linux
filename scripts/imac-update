#!/bin/bash

# Resolve the invoking user's home rather than assuming one, so these scripts run
# for any account rather than only the one they were written on.
UH=${SUDO_USER:-$(logname 2>/dev/null || echo "${USER:-root}")}
UHOME=$(getent passwd "$UH" 2>/dev/null | cut -d: -f6)
[ -n "$UHOME" ] || UHOME="$HOME"

#==============================================================================
# imac-update - update openSUSE on this iMac and re-apply every local patch
#
#   sudo imac-update              # full update, keep current kernel
#   sudo imac-update --dry-run    # show what would happen, change nothing
#   sudo imac-update --kernel     # ALSO move to the newest kernel
#   sudo imac-update --reboot     # reboot at the end (asks first)
#
# Order matters: prune ESP -> update -> rebuild the audio codec for whatever
# kernel is now newest -> re-apply -> (reboot).
#
# The audio step is not optional. The patched CS8409 codec is a DKMS module
# (snd_hda_macbookpro/0.2, jackdanyell + the headset capture patch), which
# rebuilds itself for each new kernel. It is
# still checked here, because a kernel that arrives without a built module
# boots with no patched codec and the internal speakers are silent.
# See docs/audio.md - scripts/imac-audio-module is SUPERSEDED and is not used.
#==============================================================================
set -uo pipefail

DRY=0; WANT_KERNEL=0; DO_REBOOT=0
for a in "$@"; do
  case "$a" in
    --dry-run|--check) DRY=1 ;;
    --kernel)          WANT_KERNEL=1 ;;
    --reboot)          DO_REBOOT=1 ;;
  esac
done

LOG=/var/log/imac-update.log
# This runs under sudo, so ~ is /root and not the user's home. Use an explicit
# path or the script silently reports the helpers as missing.
# install.sh puts user-facing commands in /usr/local/bin. Prefer that, and fall
# back to the invoking user's ~/bin, which is where these scripts lived before
# install.sh existed. Without the fallback a fresh install reported
# "imac-reapply MISSING - patches NOT re-applied!" at the end of every update.
if [ -x /usr/local/bin/imac-reapply ]; then
  BIN=/usr/local/bin
elif [ -x "$UHOME/bin/imac-reapply" ]; then
  BIN=$UHOME/bin
else
  BIN=/usr/local/bin
fi
say()  { printf '%s\n' "$*" | tee -a "$LOG"; }
step() { say ""; say "=== $* ==="; }
ok()   { say "  [ ok ] $*"; }
warn() { say "  [warn] $*"; }
bad()  { say "  [FAIL] $*"; }
hint() { say "    fix:  $*"; }
die()  { say "ABORT: $*"; say "see $LOG"; exit 1; }

# Kernel versions must be the full module-directory form (7.2.2-1-default).
# rpm's %{VERSION} is only the upstream part (7.2.2) and the release does not
# map cleanly onto the module directory suffix, so comparing against it makes a
# newly installed kernel look identical to the running one - which would hide a
# pending reboot. Read the BLS "version" field instead (1@7.2.2-1-default),
# falling back to the directory of the "linux" path, then to /lib/modules.
# Entries whose kernel directory no longer exists are stale and are dropped.
# This machine has two EFI partitions. The bootloader reads ONLY the ESP:
# `bootctl status` reports "Boot Loader Entry Locations: ESP: /boot/efi (..., $BOOT)"
# and nothing else, even though systemd-boot supports XBOOTLDR. An entry placed
# on the XBOOTLDR is silently ignored, which cost several reboots on 2026-10-09/10.
# See docs/boot-layout.md.
#
# So the ESP is authoritative. This matters: with ENTRYDIR pointing at the
# XBOOTLDR, every path below inspects the wrong files and reports false failures.
ENTRYDIR=/boot/efi/loader/entries
[ -d "$ENTRYDIR" ] || ENTRYDIR=/boot/efi
[ -n "$(ls -1 "$ENTRYDIR"/*.conf 2>/dev/null)" ] \
  || warn "no .conf entries in $ENTRYDIR - check that the ESP holds the boot entry"

installed_kernels() {
  local out v
  out=$(awk '/^version[[:space:]]/ { v=$2; sub(/^[^@]*@/, "", v); if (v != "") print v }' \
         "$ENTRYDIR"/*.conf 2>/dev/null | sort -uV)
  if [ -z "$out" ]; then
    out=$(awk '/^linux[[:space:]]/ { for (i=2;i<=NF;i++) if ($i ~ /^\//) { n=split($i,a,"/"); print a[n-1] } }' \
           "$ENTRYDIR"/*.conf 2>/dev/null | sort -uV)
  fi
  if [ -n "$out" ]; then
    for v in $out; do [ -d "/lib/modules/$v" ] && printf '%s\n' "$v"; done
  else
    ls -1 /lib/modules 2>/dev/null | sort -V
  fi
}

: > "$LOG"
say "############ imac-update $(date -Is)  dry=$DRY kernel=$WANT_KERNEL ############"
[ "$(id -u)" -eq 0 ] || { say "run with sudo"; exit 1; }

# One kernel+initrd pair is ~97M and the ESP is 197M, so exactly one fits.
# With --kernel the ESP is emptied first (step 1); 150M covers the new pair
# plus dracut's staging. Without it nothing is removed.
ESP_MIN_KERNEL=150   # M needed once the ESP has been emptied for a new pair
ESP_MIN_PATCH=45     # M needed for a non-kernel update

#---------------------------------------------------------------- 0. preflight
step "0. preflight"
AVAIL=$(df -m --output=avail /boot/efi | tail -1 | tr -d ' ')
say "  ESP free: ${AVAIL}M"
say "  running kernel: $(uname -r)"
say "  BLS entries: $(ls -1 "$ENTRYDIR"/*.conf 2>/dev/null | wc -l) in $ENTRYDIR"

# Panel brightness depends on this parameter, and it lives only in the BLS
# entries. Anything that regenerates them can drop it silently, and the display
# still looks perfect - so it reads as a hardware fault. Warn loudly.
BLMISS=0
for f in "$ENTRYDIR"/*.conf; do
  [ -e "$f" ] || continue
  grep -q 'acpi_backlight=video' "$f" || { say "  WARN  $(basename "$f") has no acpi_backlight=video"; BLMISS=1; }
done
if [ "$BLMISS" -eq 0 ]; then
  say "  brightness: acpi_backlight=video present in all entries"
else
  say "  an entry is missing acpi_backlight=video; brightness will not respond."
  say "  add it to that entry's options line and rebuild the initramfs."
  say "  see docs/brightness.md"
fi

if [ -f /etc/zypp/constraints.d/kernel-block.const ]; then
  say "  kernel constraint ACTIVE (holding the kernel at the version the patched amdgpu and audio DKMS builds were made for - see docs/kernel-updates.md)"
  if [ "$WANT_KERNEL" -eq 1 ]; then
    # Only --kernel makes this true. Saying "lifting" during a plain update or a
    # --dry-run would be false; the case that matters more is the else branch.
    warn "--kernel: removing the kernel constraint"
    warn "the 5K patches are verified for 7.1.x-7.2.x ONLY, and a stock amdgpu has"
    warn "no tiled_stitch parameter at all - an unbuilt kernel means no second tile"
    warn "you will need a patched amdgpu in an initramfs for the new kernel (docs/kernel-updates.md)"
  fi
else
    say "  kernel constraint absent"
    if [ "$WANT_KERNEL" -eq 1 ]; then
      # 45-amdgpu-5k.install used to make this a hard abort: with no constraint
      # and no hand-built initrd there was nothing to boot safely, so stopping was
      # correct. It is no longer fatal because the kernel-install hook now queues
      # the build itself. The kernel is still NOT safe to boot the moment zypper
      # returns - the build takes 20-45 minutes - so this is a wait, not a
      # warning you can ignore.
      warn "--kernel: no constraint, so the new kernel will arrive with a STOCK"
      warn "amdgpu, which has no tiled_stitch parameter and gives you ONE tile."
      warn "45-amdgpu-5k.install queues the patched build on kernel install."
      warn ""
      warn "After this finishes, WAIT for the build before rebooting:"
      warn "  journalctl -fu imac-amdgpu-build@<new-kver>      # watch it"
      warn "  imac-amdgpu-install --check --kver <new-kver>    # must not say stock"
      warn ""
      warn "Rebooting before that finishes costs you the second tile."
    fi
  fi

if [ "$DRY" -eq 1 ]; then
  say ""
  say "  [dry-run] would: copy the current kernel pair to the XBOOTLDR as a"
  say "  [dry-run] rollback (only with --kernel), empty the ESP, run 'zypper dup',"
  say "  [dry-run] confirm a DKMS codec build exists for the newest kernel,"
  say "  [dry-run] re-run imac-reapply, and report."
  say ""
  tmpdk=$(mktemp)
  say "  audio codec status:"
  # Assign first, test after. `grep -q` inside an `if` pipeline makes grep exit
  # at the first match and the pipeline status unreliable, which reported
  # "no DKMS codec registered" on a machine with two installed.
  if dkms status 2>/dev/null | grep -i macbookpro > "$tmpdk" 2>/dev/null; then
    sed 's/^/    /' "$tmpdk"
  else
    say "    (no DKMS codec registered - speakers would be silent after reboot)"
  fi
  rm -f "$tmpdk"
  say ""
  say "  pending updates:"
  zypper --non-interactive list-updates 2>/dev/null | head -30 | sed 's/^/    /' \
    || say "    (could not query)"
  say ""
  say "  re-apply would report:"
  "$BIN/imac-reapply" --check 2>/dev/null | grep -E "\[(warn|FAIL)\]" | sed 's/^/    /' \
    || say "    (all clean)"
  say ""
  say "  dry run complete; nothing changed."
  exit 0
fi

#----------------------------------------- 1. free ESP space before touching zypper
step "1. ESP space"

# Decide how much we need BEFORE deleting anything.
CURV=$(uname -r)
NEED=$ESP_MIN_PATCH
[ "$WANT_KERNEL" -eq 1 ] && NEED=$ESP_MIN_KERNEL
AVAIL=$(df -m --output=avail /boot/efi | tail -1 | tr -d ' ')
say "  need ${NEED}M, have ${AVAIL}M"

# Snapshot every entry first. These BLS files are regenerable metadata, but a
# backup means a mistake here is always reversible.
SAVEDIR=$UHOME/5k-stackC-backup/esp-prune-$(date +%Y%m%d-%H%M%S)
mkdir -p "$SAVEDIR"
cp -p "$ENTRYDIR"/*.conf "$SAVEDIR/" 2>/dev/null
say "  backed up all BLS entries to $SAVEDIR"

# The ESP holds ONE kernel pair (~97M of 197M). Two do not fit, and the failure
# is silent: `zypper dup` on 2026-10-09 installed 163 packages and then died
# with "No free space in /boot/efi for new kernel", leaving the new kernel
# package registered with rpm but no image on disk at all.
#
# Entries are not the problem - pruning them frees kilobytes. The payload is.
# So when a kernel is wanted, the current pair is copied to the XBOOTLDR and
# verified there FIRST, and only then is the ESP emptied.
#
# Nothing is deleted until its replacement is confirmed on the XBOOTLDR.

if [ "$WANT_KERNEL" -eq 1 ]; then
  XB=/boot/efi-xbootldr
  CUR_DIR="/boot/efi/opensuse-slowroll/$CURV"

  mkdir -p "$XB/opensuse-slowroll/$CURV"
  for pair in linux initrd; do
    if [ ! -f "$XB/opensuse-slowroll/$CURV/$pair" ]; then
      say "  preserving $CURV/$pair on the XBOOTLDR as the rollback pair"
      cp -p "$CUR_DIR/$pair" "$XB/opensuse-slowroll/$CURV/$pair" \
        || die "could not copy $pair to the XBOOTLDR; aborting before touching the ESP"
    fi
  done

  # Verify the copy before removing anything. A truncated initrd was produced
  # twice during the 2026-10-09 work by deleting the source too early.
  for pair in linux initrd; do
    a=$(stat -c %s "$CUR_DIR/$pair" 2>/dev/null)
    b=$(stat -c %s "$XB/opensuse-slowroll/$CURV/$pair" 2>/dev/null)
    [ -n "$a" ] && [ "$a" = "$b" ] \
      || die "XBOOTLDR $pair is $b bytes but the source was $a; aborting"
  done
  lsinitrd "$XB/opensuse-slowroll/$CURV/initrd" >/dev/null 2>&1 \
    || die "the XBOOTLDR rollback initrd is not a valid cpio; aborting"
  say "  rollback pair verified on the XBOOTLDR (initrd opens cleanly)"

  say "  emptying the ESP so the new pair fits"
  rm -rf /boot/efi/opensuse-slowroll
  AVAIL=$(df -m --output=avail /boot/efi | tail -1 | tr -d ' ')
  say "  ESP free now: ${AVAIL}M"
  [ "$AVAIL" -ge 150 ] || die "only ${AVAIL}M free after emptying the ESP; need 150M. Aborting."
  say "  NOTE: the old entry dangles until the new kernel is installed."
  say "  if this fails: cp -a $XB/opensuse-slowroll/$CURV /boot/efi/opensuse-slowroll/"
else
  say "  kernel not being changed; ESP left alone (${AVAIL}M free)"
fi

CUR_ENTRY=$(sed -n 's/^default=//p;/^default[[:space:]]/s/^default[[:space:]]*//p' \
            /boot/efi/loader/loader.conf 2>/dev/null | head -1)
say "  default boot entry: ${CUR_ENTRY:-unset}"

#--------------------------------------------------------- 2. kernel decision
step "2. kernel policy"
say "  running kernel version: $CURV"
if [ "$WANT_KERNEL" -eq 1 ]; then
  say "  --kernel given: removing the kernel constraint"
  rm -f /etc/zypp/constraints.d/kernel-block.const
  say "  constraint removed"
else
  say "  keeping the current kernel (constraint stays in place)"
fi

#------------------------------------------------------------------ 3. zypper
step "3. update packages"
say "  refreshing repos"
zypper --non-interactive refresh 2>&1 | tail -5 | sed 's/^/  /'
say "  running: zypper up"
zypper --non-interactive up 2>&1 | tail -25 | sed 's/^/  /'
ZRC=${PIPESTATUS[0]}
say "  zypper exit: $ZRC"
# zypper returns advisory codes that mean "succeeded, but":
#   100 = reboot needed
#   102 = restart zypper recommended
#   103 = reboot and restart recommended
# A kernel update returns one of these routinely. Treating them as fatal aborted
# the run BEFORE the audio codec was rebuilt for the new kernel - worst possible
# moment to stop.
case "$ZRC" in
  0)   say "  zypper exit: 0 (clean)" ;;
  102) say "  zypper exit: 102 (reboot needed) - continuing with the rebuild"
       ZRC=0 ;;
  103) say "  zypper exit: 103 (zypper restart needed) - re-running zypper up once"
       say "  (103 means some packages were left unapplied; this applies them)"
       zypper --non-interactive up >/dev/null 2>&1
       case "$?" in 0|102|103) ZRC=0 ;; *) die "zypper re-run failed" ;; esac ;;
  *)   die "zypper exited $ZRC - inspect the output above before continuing" ;;
esac

# re-check ESP: zypper may have consumed it (new packages with kernel modules)
AVAIL=$(df -m --output=avail /boot/efi | tail -1 | tr -d ' ')
say "  ESP free after update: ${AVAIL}M"

#------------------------------------------- 4. did the kernel actually move?
step "4. kernel status"
NEWEST2=$(installed_kernels | tail -1)
say "  running:  $CURV"
say "  newest installed: $NEWEST2"
say "  installed: $(installed_kernels | tr '\n' ' ')"
if [ "$CURV" = "$NEWEST2" ]; then
  say "  same kernel: a reboot is optional"
else
  say "  NEW KERNEL INSTALLED - a reboot is REQUIRED to activate it"
  say "  after reboot, verify: 5K tiled output, audio, then sudo ~/bin/imac-reapply --check"
fi

#------------------------------- 4a. is the new kernel actually bootable on 5K?
# The single most important check after a kernel update. A stock amdgpu has no
# tiled_stitch parameter at all, so a new kernel without a patched module boots
# to an untiled panel - or nothing at all - with nothing logged as an error.
NEWEST3=$(ls -1 /boot/efi/opensuse-slowroll/ 2>/dev/null | sort -V | tail -1)
if [ -n "$NEWEST3" ] && [ -d "/boot/efi/opensuse-slowroll/$NEWEST3" ]; then
  UPD="/usr/lib/modules/$NEWEST3/updates/amdgpu.ko.zst"
  if [ -f "$UPD" ]; then
    say "  patched amdgpu present for $NEWEST3"
    if command -v zstd >/dev/null 2>&1; then
      T=$(mktemp /tmp/amdgpu.XXXXXX.ko)
      zstd -dqf "$UPD" -o "$T" 2>/dev/null
      say "    tiled_stitch parameter: $(modinfo -p "$T" 2>/dev/null | grep -c tiled_stitch) (1 = good)"
      say "    srcversion: $(modinfo -F srcversion "$T" 2>/dev/null)"
      rm -f "$T"
    fi
  else
    warn "NO patched amdgpu for $NEWEST3 - do not make it the boot default."
    warn "Build one: patches/amdgpu-5k/README.md, then rebuild the initrd."
    warn "See docs/boot-layout.md for the full sequence."
  fi
  # and the initrd must actually contain it
  I=""
  for c in /boot/efi/opensuse-slowroll/$NEWEST3/initrd*; do [ -f "$c" ] && I=$c && break; done
  if [ -n "$I" ]; then
    say "    initrd carries updates/amdgpu.ko.zst: $(lsinitrd "$I" 2>/dev/null | grep -c 'updates/amdgpu.ko.zst')"
    say "    initrd carries the DKMS codec:     $(lsinitrd "$I" 2>/dev/null | grep -c 'updates/snd-hda-codec-cs8409.ko.zst')"
    say "    (both must be >= 1; the package's own initrd has neither)"
  fi
fi

#------------------------------- 4b. rebuild the audio codec for the new kernel
# The patched CS8409 codec is per-kernel: a new kernel needs its own build or
# the speakers go silent after the reboot. This has to be true for the kernel
# that WILL BE BOOTED, not the one currently running. (How it gets built is
# DKMS, not updates/ext01 - see below.)
step "4b. audio codec module for kernel $NEWEST2"
# The codec is a DKMS module, so DKMS rebuilds it for every new kernel on its
# own. There is nothing to invoke here - the job is to CONFIRM a module exists
# for the kernel that is about to boot, and to fail loudly if it does not.
# (The old code shelled out to scripts/imac-audio-module, which builds into
# updates/ext01. That path was measured to lose the codec bind to DKMS on this
# machine, so routing the update path through it was sending people to the
# wrong mechanism. See docs/audio.md.)
DKMS_LINE=$(dkms status 2>/dev/null | grep -i macbookpro | head -1)
if [ -z "$DKMS_LINE" ]; then
  bad "no DKMS codec registered - the speakers WILL be silent after reboot"
  hint "sudo scripts/imac-audio --install"
  hint "see docs/audio.md for the driver source and build guards"
else
  ok "DKMS codec registered: $DKMS_LINE"
  if dkms status 2>/dev/null | grep -qi ", $NEWEST2,"; then
    ok "a build exists for $NEWEST2 (the kernel about to boot)"
  else
    warn "no DKMS build listed for $NEWEST2 yet"
    warn "dkms normally builds on kernel install; force it if it did not:"
    hint "sudo scripts/imac-audio --install -k $NEWEST2"
  fi
fi

#------------------------------------------------- 5. per-package restarts
step "5. services"
# A new kernel or a kernel module needs modules reloaded; the display is XWayland
# under Plasma so a full reboot is the honest way. Log what was installed.
say "  packages installed/updated in this run:"
rpm -qa --last 2>/dev/null | head -0  # (informational only)
say "  NOTE: not restarting services automatically - the session is live."
say "  If a kernel module changed, reboot rather than reload it."

#--------------------------------------------------------- 6. re-apply patches
step "6. re-apply local patches"
if [ -x "$BIN/imac-reapply" ]; then
  "$BIN/imac-reapply" 2>&1 | sed 's/^/  /'
  say "  re-apply finished"
else
  say "  $BIN/imac-reapply MISSING - patches NOT re-applied!"
fi

step "7. final verification"
"$BIN/imac-reapply" --check 2>&1 | grep -E "\[(warn|FAIL)\]" | sed 's/^/  /' \
  || say "  all checks pass"

#------------------------------------------------------------------ 8. reboot
#
# This is the one step that can cost the display, so the gate is here rather
# than in the documentation. A stock amdgpu has no tiled_stitch parameter and
# boots ONE tile with nothing logged as an error - you only find out by looking
# at the screen, which is exactly what --reboot skips.
#
# The build is detached and takes 20-45 minutes, so "not ready yet" is the
# normal case for a minute or two after zypper returns. Offer to wait for it
# rather than refusing outright.
if [ "$DO_REBOOT" -eq 1 ] && [ "$WANT_KERNEL" -eq 1 ]; then
  step "8. reboot gate"
  AMDGPU=/usr/local/libexec/imac-amdgpu-install
  [ -x "$AMDGPU" ] || AMDGPU="$BIN/imac-amdgpu-install"
  if [ ! -x "$AMDGPU" ]; then
    warn "cannot find imac-amdgpu-install; cannot verify the 5K module is built"
  else
    TRIED=0
    while :; do
      # Fail CLOSED. An earlier version of this gate tested for the string
      # "not the stock module", which meant any error from imac-amdgpu-install -
      # missing binary, unbuilt module, no such kernel - fell through to
      # "not ready" and then, on Enter, to a reboot anyway. Wrong direction.
      # Only an explicit "not stock" plus a zero exit means ready.
      OUT=$("$AMDGPU" --check --kver "$NEWEST2" 2>&1); RC=$?
      if [ "$RC" -eq 0 ] && printf '%s' "$OUT" | grep -q "not the stock module"; then
        ok "patched amdgpu present for $NEWEST2"
        break
      fi
      if [ "$RC" -ne 0 ]; then
        say "  check failed (exit $RC): $(printf '%s' "$OUT" | tail -1)"
      fi
      TRIED=$((TRIED+1))
      if [ "$TRIED" -eq 1 ]; then
        say "  the patched amdgpu build for $NEWEST2 is not finished."
        say "  It is detached and takes 20-45 minutes. Rebooting now boots a"
        say "  stock amdgpu: one tile, no error message, degraded display."
        say ""
        say "  press Enter to wait for it, or Ctrl-C to stop here and reboot later."
        read -r _ || { say "  interrupted; not rebooting"; exit 0; }
      fi
      sleep 60
      printf '.'
    done
    echo
  fi
fi

if [ "$DO_REBOOT" -eq 1 ]; then
  say ""
  read -rp "Reboot now? [y/N] " a
  [ "$a" = "y" ] && { say "rebooting"; reboot; } || say "not rebooting"
else
  say ""
  if [ "$WANT_KERNEL" -eq 1 ]; then
    say "No reboot performed. Before you do, confirm the build finished:"
    say "  sudo /usr/local/libexec/imac-amdgpu-install --check --kver $NEWEST2"
  else
    say "No reboot performed. When you do reboot, verify the 5K tiled output."
  fi
fi

say ""
say "############ done $(date -Is) - log: $LOG ############"
exit 0