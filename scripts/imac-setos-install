#!/bin/bash
# Patch the ESP kernel in place and keep exactly one boot entry.
#
# Usage: imac-setos-install <kver>
#
# Why in place and not "copy stock -> linux-setos": the ESP is 197 MiB and one
# kernel+initrd pair is ~95 MiB, so it holds ONE pair. Keeping a stock kernel
# beside the patched one needs ~113 MiB, and a new install arriving on top of
# that needs ~190 MiB, which does not fit. Measured: with a stock copy present,
# a subsequent install truncated linux-setos to 8 MiB. So the stock kernel stays
# on the XBOOTLDR (3.6 GiB, plenty) and the ESP carries only the patched pair.
#
# <kver> is the version being installed, passed by 96-imac-setos.install. It is
# NOT `uname -r`: the hook runs at install time while the old kernel is still
# running, so uname would name the old one and the new kernel would stay stock.
set -u
ESP=/boot/efi
PATCHER=/usr/local/libexec/imac-setos-patch

KV="${1:-}"
if [ -z "$KV" ]; then
  echo "  imac-setos-install: no kver given (run from the 96 hook), skipping"
  exit 0
fi
echo "  imac-setos-install: installing for $KV"

D="$ESP/opensuse-slowroll/$KV"
[ -d "$D" ] || { echo "  imac-setos-install: $D missing, skipping"; exit 0; }

# kernel-install names the image "linux" in a BLS layout, but be tolerant of
# content-hashed names. Never re-derive from linux-setos.
SRC=""
for cand in "$D/linux" "$D"/linux-*; do
  [ -f "$cand" ] || continue
  case "$(basename "$cand")" in linux-setos) continue ;; esac
  SRC="$cand"; break
done
[ -n "$SRC" ] || { echo "  imac-setos-install: no kernel image in $D, skipping"; exit 0; }

# Already patched (e.g. a hook re-run)? Then just make sure the entry is right.
if "$PATCHER" "$SRC" | grep -q 'already patched'; then
  echo "  imac-setos-install: $SRC is already patched"
else
  echo "  imac-setos-install: patching $(basename "$SRC")"
  "$PATCHER" "$SRC" || { echo "  imac-setos-install: PATCH FAILED - iGPU will be absent"; exit 1; }
  # The patched image IS the bootable kernel; drop any separate copy so the ESP
  # holds one pair only.
  rm -f "$D/linux-setos"
fi

INITRD=""
for cand in "$D/initrd" "$D"/initrd-*; do
  [ -f "$cand" ] || continue
  INITRD="$cand"; break
done
[ -f "$INITRD" ] || { echo "  imac-setos-install: no initrd in $D, skipping entry"; exit 0; }

OPTS=""
for e in "$ESP"/loader/entries/*.conf; do
  [ -e "$e" ] || continue
  o=$(awk '$1=="options"{$1="";print}' "$e" 2>/dev/null)
  if printf '%s' "$o" | grep -q "$KV"; then OPTS="$o"; break; fi
done
[ -n "$OPTS" ] || OPTS="root=UUID=1706cca7-206b-4c12-b596-f5079d2d024f amdgpu.tiled_stitch=-1 acpi_backlight=video security=selinux selinux=1 mitigations=auto rootflags=subvol=@/.snapshots/1/snapshot"

# Exactly one entry. A stock entry alongside ours is what systemd-boot picks.
mkdir -p /var/tmp/boot-entries-parked
for e in "$ESP"/loader/entries/*.conf; do
  [ -e "$e" ] || continue
  [ "$(basename "$e")" = "aaa-igpu-setos.conf" ] && continue
  cp -a "$e" /var/tmp/boot-entries-parked/ 2>/dev/null
  rm -f "$e"
  echo "  imac-setos-install: parked $(basename "$e")"
done

# Always the image we just patched, in THIS version's directory. Never reuse the
# path from the previous entry: after an update it names the old version, and the
# prune that follows would then delete the entry we just wrote.
KB="/opensuse-slowroll/$KV/$(basename "$SRC")"

cat > "$ESP/loader/entries/aaa-igpu-setos.conf" <<EOF2
# iMac19,1: the Intel UHD 630 is exposed because this kernel image carries
# iMac19,1 in the EFI stub's apple_match_product_name() list, so the stub calls
# Apple's set_os protocol and the firmware publishes 00:02.0. The image is
# byte-identical in size to a stock kernel; only the last 15-byte model slot
# differs. Patched in place by /usr/local/libexec/imac-setos-install. The stock
# kernel is kept on the XBOOTLDR: the ESP has room for one pair only.
title      openSUSE $KV (iGPU: set_os patched)
version    $KV
sort-key   01-setos
linux      $KB
initrd     /opensuse-slowroll/$KV/$(basename "$INITRD")
options    $OPTS
EOF2
echo "  imac-setos-install: entry written -> $(basename "$KB") + $(basename "$INITRD")"
sed -i 's|^default .*|default aaa-igpu-setos.conf|' "$ESP/loader/loader.conf" 2>/dev/null
exit 0
