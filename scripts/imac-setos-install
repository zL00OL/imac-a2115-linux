#!/bin/bash
# Regenerate the set_os-patched kernel and its BLS entry after a kernel install.
#
# Two things go wrong without this:
#  1. kernel-install drops a fresh stock kernel + entry on the ESP, and the
#     stock entry is the one systemd-boot tends to pick, silently costing the
#     iGPU (and with it QuickSync).
#  2. The patched image must be rebuilt for each new kernel, since the change
#     lives in the kernel image and nowhere else.
#
# The initrd is NOT copied: the ESP is 197M and one kernel+initrd pair is ~101M,
# so the entry reuses the initrd kernel-install just wrote.
set -u
ESP=/boot/efi
PATCHER=/usr/local/libexec/imac-setos-patch
KV=$(uname -r)
D="$ESP/opensuse-slowroll/$KV"
[ -d "$D" ] || exit 0

# Find the kernel kernel-install just wrote (newest file matching linux-*, or linux).
NEWEST=$(ls -1t "$D"/linux-* 2>/dev/null | head -1)
[ -n "$NEWEST" ] || NEWEST="$D/linux"
[ -f "$NEWEST" ] || exit 0

# Never re-derive from our own patched copy.
case "$(basename "$NEWEST")" in linux-setos) exit 0;; esac

echo "  imac-setos-install: deriving from $(basename "$NEWEST")"
cp -p "$NEWEST" "$D/linux-setos" || { echo "  imac-setos-install: copy failed (ESP full?)"; exit 1; }
"$PATCHER" "$D/linux-setos" || exit 1

# Newest initrd kernel-install produced.
INITRD=$(ls -1t "$D"/initrd-* "$D"/initrd 2>/dev/null | head -1)
[ -f "$INITRD" ] || { echo "  imac-setos-install: no initrd found"; exit 1; }

# Options: reuse what kernel-install generated so we track its root/snapshot.
OPTS=""
for e in "$ESP"/loader/entries/opensuse-slowroll-*.conf; do
  [ -e "$e" ] || continue
  OPTS=$(awk '$1=="options"{$1="";print}' "$e")
  [ -n "$OPTS" ] && break
done
[ -n "$OPTS" ] || OPTS="root=UUID=1706cca7-206b-4c12-b596-f5079d2d024f amdgpu.tiled_stitch=-1 acpi_backlight=video security=selinux selinux=1 mitigations=auto rootflags=subvol=@/.snapshots/1/snapshot"

cat > "$ESP/loader/entries/aaa-igpu-setos.conf" <<EOF2
# iMac19,1: the Intel UHD 630 is exposed because this kernel image carries
# iMac19,1 in the EFI stub's apple_match_product_name() list, so the stub calls
# Apple's set_os protocol and the firmware publishes 00:02.0. The image is
# byte-identical in size to the stock kernel; only the last 15-byte model slot
# differs. Regenerated by /usr/local/libexec/imac-setos-install.
title      openSUSE $KV (iGPU: set_os patched)
version    $KV
sort-key   01-setos
linux      /opensuse-slowroll/$KV/linux-setos
initrd     /opensuse-slowroll/$KV/$(basename "$INITRD")
options    $OPTS
EOF2
echo "  imac-setos-install: entry written, initrd=$(basename "$INITRD")"

# Park the stock entry so the bootloader has exactly one choice. A stock entry
# present alongside ours is what systemd-boot has picked instead of ours.
mkdir -p /var/tmp/boot-entries-parked
for e in "$ESP"/loader/entries/opensuse-slowroll-*.conf; do
  [ -e "$e" ] || continue
  cp -a "$e" /var/tmp/boot-entries-parked/ 2>/dev/null
  rm -f "$e"
  echo "  imac-setos-install: parked $(basename "$e")"
done

sed -i 's|^default .*|default aaa-igpu-setos.conf|' "$ESP/loader/loader.conf" 2>/dev/null
exit 0
